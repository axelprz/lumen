<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Lumen.InputTemplate" TargetType="Control">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="10">
      <!-- No Margin here: TextBox/PasswordBox already apply their Padding to the text inside the content host.
           Binding it again doubled the inset (typed text started far from where the placeholder is). -->
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Brand}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Lumen.Brush.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Lumen.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Brush.FillBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template" Value="{StaticResource Lumen.InputTemplate}" />
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource Lumen.Brush.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Lumen.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Brush.FillBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template" Value="{StaticResource Lumen.InputTemplate}" />
  </Style>

  <!-- On/off switch: a CheckBox with a track and a knob. Space or Enter toggles it; focus draws the brand ring. -->
  <Style x:Key="Lumen.Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="44" Height="24" Background="Transparent">
            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource Lumen.Brush.FillHover}"
                    BorderBrush="{DynamicResource Lumen.Brush.FillBorder}" BorderThickness="1" />
            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource Lumen.Brush.TextMuted}" />
            <Border x:Name="FocusRing" Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource Lumen.Brush.BrandText}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Lumen.Brush.BrandGradient}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="#26FFFFFF" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="White" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Lumen.Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
</ResourceDictionary>
