<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Secondary button: quiet translucent fill. Hover lays a light sheen over whatever background the button has,
       so the same template works for glass, brand gradient and custom backgrounds. Keyboard/gamepad focus draws a brand ring. -->
  <Style x:Key="Lumen.Button" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Lumen.Brush.Fill}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Brush.FillBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" />
            <Border x:Name="Sheen" CornerRadius="10" Background="#17FFFFFF" Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="FocusRing" Margin="-3" CornerRadius="13" BorderThickness="2"
                    BorderBrush="{DynamicResource Lumen.Brush.BrandText}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary action (Play, Save, Create): the brand gradient, white text. -->
  <Style x:Key="Lumen.Button.Primary" TargetType="Button" BasedOn="{StaticResource Lumen.Button}">
    <Setter Property="Background" Value="{DynamicResource Lumen.Brush.BrandGradient}" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Square button holding one Segoe Fluent glyph (top bar, row actions). -->
  <Style x:Key="Lumen.Button.Icon" TargetType="Button" BasedOn="{StaticResource Lumen.Button}">
    <Setter Property="Padding" Value="10" />
    <Setter Property="FontFamily" Value="{StaticResource Lumen.Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
  </Style>

  <!-- Play/Install on a library tile: brand when installed, neutral when it would open the store to install. -->
  <Style x:Key="Lumen.Button.Tile" TargetType="Button" BasedOn="{StaticResource Lumen.Button}">
    <Setter Property="Padding" Value="0,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsInstalled}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Lumen.Brush.BrandGradient}" />
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
