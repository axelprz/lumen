<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Lumen.Button" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Lumen.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Lumen.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Play/Install on a library tile: accent when installed, neutral when it would open the store to install. -->
  <Style x:Key="Lumen.Button.Tile" TargetType="Button" BasedOn="{StaticResource Lumen.Button}">
    <Setter Property="Padding" Value="0,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsInstalled}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Lumen.Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
