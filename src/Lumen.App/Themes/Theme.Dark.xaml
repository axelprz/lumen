<!-- Palette tokens. Always reference brushes with DynamicResource: the accent is replaced at runtime (AccentService, M3). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Deep blue-black base (M10 template, 2026-10-30). -->
  <Color x:Key="Lumen.Color.Background">#FF0A0D14</Color>
  <Color x:Key="Lumen.Color.Sidebar">#FF0E121B</Color>
  <Color x:Key="Lumen.Color.Surface">#FF182030</Color>
  <Color x:Key="Lumen.Color.SurfaceHover">#FF1F2A40</Color>
  <Color x:Key="Lumen.Color.Divider">#17FFFFFF</Color>
  <Color x:Key="Lumen.Color.Text">#FFF1F5F9</Color>
  <Color x:Key="Lumen.Color.TextMuted">#FF94A3B8</Color>
  <!-- The game accent: AccentService replaces it with the featured game's color (hero, page background, cover glow). -->
  <Color x:Key="Lumen.Color.Accent">#FF3B82F6</Color>
  <!-- The brand: fixed blue to violet. Chrome (sidebar, buttons, top bar, focus rings) uses it, never the game accent. -->
  <Color x:Key="Lumen.Color.Brand">#FF3B82F6</Color>
  <Color x:Key="Lumen.Color.BrandMid">#FF6366F1</Color>
  <Color x:Key="Lumen.Color.BrandAlt">#FF8B5CF6</Color>

  <SolidColorBrush x:Key="Lumen.Brush.Background" Color="{StaticResource Lumen.Color.Background}" />
  <SolidColorBrush x:Key="Lumen.Brush.Sidebar" Color="{StaticResource Lumen.Color.Sidebar}" />
  <SolidColorBrush x:Key="Lumen.Brush.Surface" Color="{StaticResource Lumen.Color.Surface}" />
  <SolidColorBrush x:Key="Lumen.Brush.SurfaceHover" Color="{StaticResource Lumen.Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Lumen.Brush.Divider" Color="{StaticResource Lumen.Color.Divider}" />
  <SolidColorBrush x:Key="Lumen.Brush.Text" Color="{StaticResource Lumen.Color.Text}" />
  <SolidColorBrush x:Key="Lumen.Brush.TextMuted" Color="{StaticResource Lumen.Color.TextMuted}" />
  <!-- The window and sidebar backdrops are opaque here; MicaBackdrop swaps them for translucent ones when Windows 11 shows Mica. -->
  <SolidColorBrush x:Key="Lumen.Brush.Backdrop" Color="{StaticResource Lumen.Color.Background}" />
  <SolidColorBrush x:Key="Lumen.Brush.SidebarBackdrop" Color="{StaticResource Lumen.Color.Sidebar}" />
  <SolidColorBrush x:Key="Lumen.Brush.CoverEdge" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Lumen.Brush.Accent" Color="{StaticResource Lumen.Color.Accent}" />
  <SolidColorBrush x:Key="Lumen.Brush.Success" Color="#FF34D399" />
  <SolidColorBrush x:Key="Lumen.Brush.Warning" Color="#FFFBBF24" />
  <SolidColorBrush x:Key="Lumen.Brush.Error" Color="#FFF2766B" />

  <!-- Brand brushes -->
  <SolidColorBrush x:Key="Lumen.Brush.Brand" Color="{StaticResource Lumen.Color.Brand}" />
  <SolidColorBrush x:Key="Lumen.Brush.BrandText" Color="#FF60A5FA" />
  <SolidColorBrush x:Key="Lumen.Brush.BrandSoft" Color="#333B82F6" />
  <SolidColorBrush x:Key="Lumen.Brush.BrandBorder" Color="#663B82F6" />
  <LinearGradientBrush x:Key="Lumen.Brush.BrandGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource Lumen.Color.Brand}" Offset="0" />
    <GradientStop Color="{StaticResource Lumen.Color.BrandMid}" Offset="0.55" />
    <GradientStop Color="{StaticResource Lumen.Color.BrandAlt}" Offset="1" />
  </LinearGradientBrush>
  <!-- Hover: the same gradient a step lighter -->
  <LinearGradientBrush x:Key="Lumen.Brush.BrandGradientHover" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF5B96F8" Offset="0" />
    <GradientStop Color="#FF7C7FF4" Offset="0.55" />
    <GradientStop Color="#FFA07CF9" Offset="1" />
  </LinearGradientBrush>
  <!-- Selected sidebar item: brand tint fading to the right -->
  <LinearGradientBrush x:Key="Lumen.Brush.BrandFade" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#2E3B82F6" Offset="0" />
    <GradientStop Color="#053B82F6" Offset="1" />
  </LinearGradientBrush>

  <!-- Glass (M10 template): cards are about 85% opaque so the ambient light shows through a little; text stays readable.
       Raise the alpha (D9 = 85%) toward FF to make them more solid. -->
  <SolidColorBrush x:Key="Lumen.Brush.Glass" Color="#D9182030" />
  <SolidColorBrush x:Key="Lumen.Brush.GlassHover" Color="#E61E2940" />
  <SolidColorBrush x:Key="Lumen.Brush.GlassBorder" Color="#14FFFFFF" />
  <!-- Quiet fills for secondary buttons, chips and inputs -->
  <SolidColorBrush x:Key="Lumen.Brush.Fill" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Lumen.Brush.FillHover" Color="#1CFFFFFF" />
  <SolidColorBrush x:Key="Lumen.Brush.FillBorder" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Lumen.Brush.Input" Color="#CC0F1520" />

  <!-- Ambient lights behind the pages (MainWindow). Alpha 0x26 = 15%; raise it to make the light stronger. -->
  <RadialGradientBrush x:Key="Lumen.Brush.AmbientBlue">
    <GradientStop Color="#262563EB" Offset="0" />
    <GradientStop Color="#0D2563EB" Offset="0.55" />
    <GradientStop Color="#002563EB" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="Lumen.Brush.AmbientViolet">
    <GradientStop Color="#267C3AED" Offset="0" />
    <GradientStop Color="#0D7C3AED" Offset="0.55" />
    <GradientStop Color="#007C3AED" Offset="1" />
  </RadialGradientBrush>

  <!-- UI font: Exo 2 (SIL OFL, M10). Four static weights ship in Assets/Fonts; the family is looked up by name inside that folder. -->
  <FontFamily x:Key="Lumen.Font.Ui">/Lumen;component/Assets/Fonts/#Exo 2</FontFamily>
  <FontFamily x:Key="Lumen.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Type scale. New and reworked screens use these tokens instead of literal sizes. -->
  <sys:Double x:Key="Lumen.FontSize.Label">11</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Small">13</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Lead">15</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.BodyLarge">16</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Subtitle">18</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Section">20</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Title">24</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Headline">32</sys:Double>
  <sys:Double x:Key="Lumen.FontSize.Display">44</sys:Double>

  <!-- Every window, tooltip and menu starts from the UI font; icon glyphs keep their own family. -->
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource Lumen.Font.Ui}" />
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource Lumen.Font.Ui}" />
  </Style>
  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource Lumen.Font.Ui}" />
  </Style>

  <Style x:Key="Lumen.Text.Brand" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Title}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="24,28,24,24" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
  </Style>

  <Style x:Key="Lumen.Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Headline}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
  </Style>

  <Style x:Key="Lumen.Text.Subtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
  </Style>

  <Style x:Key="Lumen.Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
  </Style>

  <Style x:Key="Lumen.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
  </Style>

  <Style x:Key="Lumen.Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lumen.Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
