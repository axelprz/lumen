<Application x:Class="Lumen.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lumen.App.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.Dark.xaml" />
        <ResourceDictionary Source="Themes/Controls/Surfaces.xaml" />
        <ResourceDictionary Source="Themes/Controls/Sidebar.xaml" />
        <ResourceDictionary Source="Themes/Controls/Buttons.xaml" />
        <ResourceDictionary Source="Themes/Controls/Inputs.xaml" />
        <ResourceDictionary Source="Themes/Controls/ComboBox.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:InverseBooleanConverter x:Key="InverseBool" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
