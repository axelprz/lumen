<UserControl x:Class="Lumen.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             xmlns:conv="clr-namespace:Lumen.App.Converters"
             xmlns:views="clr-namespace:Lumen.App.Views"
             AllowDrop="True"
             PreviewKeyDown="OnPreviewKeyDown"
             DragOver="OnDragOver"
             Drop="OnDrop">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ImagePathConverter x:Key="ImagePath" />
    <!-- Per-tile menu built by the view model (store choice, separate, edit/remove). Separators have no command. -->
    <ContextMenu x:Key="TileMenu" x:Shared="False" ItemsSource="{Binding MenuItems}">
      <ContextMenu.ItemContainerStyle>
        <Style TargetType="MenuItem">
          <Setter Property="Header" Value="{Binding Header}" />
          <Setter Property="Command" Value="{Binding Command}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="MenuItem">
                    <Separator Margin="0,2" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContextMenu.ItemContainerStyle>
    </ContextMenu>
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:LibraryTileViewModel}">
      <Border x:Name="Tile" Width="168" Margin="0,0,20,24" Background="Transparent" ToolTip="{Binding Title}" Loaded="OnTileLoaded">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasMenu}" Value="True">
                <Setter Property="ContextMenu" Value="{StaticResource TileMenu}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Border x:Name="Cover" Height="252" CornerRadius="8" ClipToBounds="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF232836" Offset="0" />
                <GradientStop Color="#FF171A22" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <!-- The cover is a button: click or Enter opens the detail view. Play stays a separate button on top. -->
              <Button x:Name="CoverButton"
                      Command="{Binding OpenDetailCommand}"
                      Cursor="Hand"
                      AutomationProperties.Name="{Binding Title}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Focus" Background="Transparent" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <!-- Cover art (rounded through the border); the initial shows until it loads or when there is none. -->
                  <Border CornerRadius="8">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePath}, ConverterParameter=336}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                  <!-- No cover: the app's (or package's) icon, centered -->
                  <Image Source="{Binding IconPath, Converter={StaticResource ImagePath}, ConverterParameter=224}"
                         Width="112"
                         Height="112"
                         Margin="0,0,0,40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock x:Name="Initial"
                             Text="{Binding Initial}"
                             FontSize="72"
                             FontWeight="Light"
                             Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                             Opacity="0.6"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,0,0,40" />
                </Grid>
              </Button>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="8"
                      Padding="8,3"
                      CornerRadius="4"
                      Background="#B30F1115"
                      IsHitTestVisible="False">
                <TextBlock Text="{Binding StoreName}" FontSize="11" Foreground="{DynamicResource Lumen.Brush.Text}" />
              </Border>
              <Button VerticalAlignment="Bottom"
                      Margin="10"
                      Command="{Binding PrimaryCommand}"
                      Content="{Binding ActionText}"
                      Style="{StaticResource Lumen.Button.Tile}" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding Title}"
                     Margin="2,10,2,0"
                     FontSize="14"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     Height="40" />
          <!-- Fixed heights keep every row the same size, which keeps virtualized scrolling smooth. -->
          <TextBlock Text="{Binding StateText}"
                     Margin="2,2,2,0"
                     Height="16"
                     FontSize="12"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
          <Setter TargetName="Cover" Property="Opacity" Value="0.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasCover}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
  <!-- "Discover apps" covers the page while open -->
  <Border Panel.ZIndex="6"
          Background="{DynamicResource Lumen.Brush.Background}"
          Padding="40,32,24,16"
          DataContext="{Binding Discover}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
    <views:DiscoverAppsView />
  </Border>

  <!-- The open game's detail view covers the whole page; the library keeps its scroll and filters underneath. -->
  <ContentControl Panel.ZIndex="5"
                  Content="{Binding Detail}"
                  Focusable="False"
                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
    <ContentControl.ContentTemplate>
      <DataTemplate DataType="{x:Type vm:GameDetailViewModel}">
        <views:GameDetailView />
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>

  <Grid Margin="40,32,16,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,24,20" LastChildFill="True">
      <Button DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Margin="12,0,0,0"
              Command="{Binding AddManualItemCommand}"
              AutomationProperties.Name="{l:Loc Library_Add}"
              Style="{StaticResource Lumen.Button}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{l:Loc Library_Add}" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Margin="12,0,0,0"
              Command="{Binding Discover.OpenCommand}"
              AutomationProperties.Name="{Binding Discover.ButtonText}"
              Style="{StaticResource Lumen.Button}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE71D;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Discover.ButtonText}" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Command="{Binding RescanCommand}"
              AutomationProperties.Name="{l:Loc Library_Rescan}"
              Style="{StaticResource Lumen.Button}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{l:Loc Library_Rescan}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Text" Value="{l:Loc Library_Scanning}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="{l:Loc Nav_Library}" Style="{StaticResource Lumen.Text.PageTitle}" />
        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Lumen.Brush.TextMuted}" FontSize="14" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Search, filters and sort. Ctrl+F focuses the search box; Esc clears it. -->
    <WrapPanel Grid.Row="1" Margin="0,0,24,16">
      <Grid Width="240" Height="36" Margin="0,0,12,8">
        <TextBox x:Name="SearchBox"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="30,0,8,0"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="{l:Loc Library_Search}" />
        <TextBlock Text="&#xE721;"
                   Style="{StaticResource Lumen.Text.Icon}"
                   FontSize="14"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                   HorizontalAlignment="Left"
                   Margin="12,0,0,0"
                   IsHitTestVisible="False" />
        <TextBlock Text="{l:Loc Library_Search}"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="34,0,0,0"
                   IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_TypeLabel}" />
      <ComboBox ItemsSource="{Binding StoreOptions}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_StoreLabel}" />
      <ComboBox ItemsSource="{Binding InstallOptions}" SelectedItem="{Binding SelectedInstall}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_StateLabel}" />
      <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" MinWidth="180" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Sort_Label}" />
      <Button Command="{Binding ClearFiltersCommand}"
              Content="{l:Loc Filter_Clear}"
              Style="{StaticResource Lumen.Button}"
              Height="36"
              Margin="0,0,12,8"
              Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}" />
      <!-- Switches between the library and the items the user hid; only there once something is hidden. -->
      <Button Command="{Binding ToggleHiddenCommand}"
              Style="{StaticResource Lumen.Button}"
              Height="36"
              Margin="0,0,12,8"
              AutomationProperties.Name="{Binding HiddenToggleText}"
              Visibility="{Binding HasHiddenToggle, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xED1A;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{Binding HiddenToggleText}" />
        </StackPanel>
      </Button>
    </WrapPanel>

    <!-- Non-blocking notice (scan problems, launch failures) -->
    <Border Grid.Row="2"
            Margin="0,0,24,16"
            Padding="14,10"
            CornerRadius="6"
            Background="{DynamicResource Lumen.Brush.Surface}"
            BorderBrush="{DynamicResource Lumen.Brush.Divider}"
            BorderThickness="1"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Lumen.Text.Icon}" Foreground="#FFE0B44C" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" />
      </DockPanel>
    </Border>

    <!-- Empty states: nothing in the library at all, or nothing matching the filters. ZIndex keeps them above
         the (empty, but hit-testable) grid that shares this row, so anything clickable here gets the mouse. -->
    <TextBlock Grid.Row="3"
               Panel.ZIndex="1"
               Text="{l:Loc Library_Empty}"
               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
               FontSize="15"
               TextWrapping="Wrap"
               MaxWidth="520"
               HorizontalAlignment="Left"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    <!-- "Clear filters" lives in the filter bar only; a second copy here was redundant. -->
    <TextBlock Grid.Row="3"
               Panel.ZIndex="1"
               Text="{l:Loc Library_NoMatches}"
               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
               FontSize="15"
               HorizontalAlignment="Left"
               Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />

    <!-- Grid of covers: a virtualized list of rows (WPF has no virtualizing wrap panel), so only rows on
         screen and their images exist in memory. The view sets ColumnCount from its width. -->
    <ItemsControl x:Name="RowsHost"
                  Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  SizeChanged="OnGridSizeChanged"
                  Focusable="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsPresenter Margin="0,0,0,24" />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:TileRow}">
          <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
  </Grid>
</UserControl>
