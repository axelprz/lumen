<UserControl x:Class="Lumen.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             xmlns:conv="clr-namespace:Lumen.App.Converters"
             xmlns:views="clr-namespace:Lumen.App.Views"
             xmlns:services="clr-namespace:Lumen.App.Services"
             AllowDrop="True"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown"
             DragOver="OnDragOver"
             Drop="OnDrop">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ImagePathConverter x:Key="ImagePath" />
    <!-- Per-tile menu built by the view model (store choice, separate, edit/remove). Separators have no command. -->
    <ContextMenu x:Key="TileMenu" x:Shared="False" ItemsSource="{Binding MenuItems}">
      <ContextMenu.ItemContainerStyle>
        <Style TargetType="MenuItem">
          <Setter Property="Header" Value="{Binding Header}" />
          <Setter Property="Command" Value="{Binding Command}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="MenuItem">
                    <Separator Margin="0,2" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContextMenu.ItemContainerStyle>
    </ContextMenu>
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:LibraryTileViewModel}">
      <!-- The menu is built when it opens (OnTileContextMenuOpening), not for every tile that scrolls into view -->
      <!-- 8 px of padding all round: a pointed-at cover (scaled up, ring and glow) stays inside its own tile, so nothing above it can clip it at any window size. Width and margins add up to the old 188 px slot. -->
      <Border x:Name="Tile" Width="184" Padding="8" Margin="0,0,4,-4" Background="Transparent" ToolTip="{Binding Title}"
              Loaded="OnTileLoaded" ContextMenuOpening="OnTileContextMenuOpening"
              MouseEnter="OnTileInteract" GotKeyboardFocus="OnTileInteract">
        <StackPanel>
          <Grid services:Motion.HoverScale="1.04">
          <!-- Hover/focus glow: the accent fading out around the cover. Plain brushes and a mask, no bitmap effects (those cost scroll frames); collapsed (free) until needed. -->
          <Border x:Name="Glow" Margin="-8" CornerRadius="22" Visibility="Collapsed" IsHitTestVisible="False"
                  Background="{Binding GlowBrush}" Opacity="0.45">
            <Border.OpacityMask>
              <RadialGradientBrush>
                <GradientStop Color="#FF000000" Offset="0.7" />
                <GradientStop Color="#00000000" Offset="1" />
              </RadialGradientBrush>
            </Border.OpacityMask>
          </Border>
          <Border x:Name="Cover" Height="252" CornerRadius="14" ClipToBounds="True"
                  BorderThickness="1" BorderBrush="{DynamicResource Lumen.Brush.CoverEdge}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1F2A40" Offset="0" />
                <GradientStop Color="#FF121723" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <!-- The cover is a button: click or Enter opens the detail view. Play stays a separate button on top. -->
              <Button x:Name="CoverButton"
                      Command="{Binding OpenDetailCommand}"
                      Cursor="Hand"
                      AutomationProperties.Name="{Binding Title}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Focus" Background="Transparent" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <!-- Cover art (rounded through the border); the initial shows until it loads or when there is none. -->
                  <Border CornerRadius="13">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                  <!-- No cover: the app's (or package's) icon, centered -->
                  <Image Source="{Binding IconImage}"
                         Width="112"
                         Height="112"
                         Margin="0,0,0,40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock x:Name="Initial"
                             Text="{Binding Initial}"
                             FontSize="72"
                             FontWeight="Light"
                             Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                             Opacity="0.6"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,0,0,40" />
                </Grid>
              </Button>
              <!-- Bottom shade: the Play button and the cover's lower edge read on any art (one plain brush, no effect) -->
              <Border CornerRadius="13" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000A0D14" Offset="0.5" />
                    <GradientStop Color="#D90A0D14" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- Favorite star -->
              <Border HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="8"
                      Padding="5,3"
                      Style="{StaticResource Lumen.Badge}"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE735;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Caption}" Foreground="{DynamicResource Lumen.Brush.Warning}" />
              </Border>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="8"
                      Style="{StaticResource Lumen.Badge}"
                      IsHitTestVisible="False">
                <TextBlock Text="{Binding StoreName}" Style="{StaticResource Lumen.Text.Badge}" />
              </Border>
              <Button VerticalAlignment="Bottom"
                      Margin="10"
                      Command="{Binding PrimaryCommand}"
                      Content="{Binding ActionText}"
                      Style="{StaticResource Lumen.Button.Tile}" />
            </Grid>
          </Border>
          </Grid>
          <TextBlock Text="{Binding Title}"
                     Margin="2,10,2,0"
                     FontSize="{StaticResource Lumen.FontSize.Body}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     Height="40" />
          <!-- Fixed heights keep every row the same size, which keeps virtualized scrolling smooth. -->
          <TextBlock Text="{Binding StateText}"
                     Margin="2,2,2,0"
                     Height="16"
                     FontSize="{StaticResource Lumen.FontSize.Caption}"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <!-- Pointed at or focused: the glow, plus a crisp ring in the same color so it also reads on pale covers -->
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
          <Setter TargetName="Cover" Property="BorderThickness" Value="2" />
          <Setter TargetName="Cover" Property="BorderBrush" Value="{Binding GlowBrush}" />
        </Trigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
          <Setter TargetName="Cover" Property="BorderThickness" Value="2" />
          <Setter TargetName="Cover" Property="BorderBrush" Value="{Binding GlowBrush}" />
        </Trigger>
        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
          <Setter TargetName="Cover" Property="Opacity" Value="0.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasCover}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
  <!-- "Discover apps" covers the page while open -->
  <Border Panel.ZIndex="6"
          services:GamepadLayer.Priority="2"
          Background="{DynamicResource Lumen.Brush.Background}"
          Padding="40,32,24,16"
          services:Motion.ShowIn="True"
          DataContext="{Binding Discover}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
    <views:DiscoverAppsView />
  </Border>

  <!-- The open game's detail view covers the whole page; the library keeps its scroll and filters underneath. -->
  <ContentControl Panel.ZIndex="5"
                  services:GamepadLayer.Priority="1"
                  Content="{Binding Detail}"
                  Focusable="False"
                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
    <ContentControl.ContentTemplate>
      <DataTemplate DataType="{x:Type vm:GameDetailViewModel}">
        <views:GameDetailView />
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>

  <Grid x:Name="PageBlocks" Margin="40,28,16,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header card: title and count, Rescan / Discover apps / Add, then filters and sort.
         The search box is in the window's top bar (Ctrl+K / Ctrl+F). -->
    <Border Grid.Row="0" Style="{StaticResource Lumen.Card}" Padding="20,18" Margin="0,0,24,18">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0"
                  Command="{Binding AddManualItemCommand}"
                  AutomationProperties.Name="{l:Loc Library_Add}"
                  Style="{StaticResource Lumen.Button.Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
              <TextBlock Text="{l:Loc Library_Add}" />
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0"
                  Command="{Binding Discover.OpenCommand}"
                  AutomationProperties.Name="{Binding Discover.ButtonText}"
                  Style="{StaticResource Lumen.Button}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71D;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding Discover.ButtonText}" />
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Command="{Binding RescanCommand}"
                  AutomationProperties.Name="{l:Loc Library_Rescan}"
                  Style="{StaticResource Lumen.Button}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{l:Loc Library_Rescan}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsScanning}" Value="True">
                        <Setter Property="Text" Value="{l:Loc Library_Scanning}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="{l:Loc Nav_Library}" FontSize="{StaticResource Lumen.FontSize.Title}" FontWeight="Bold" />
            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Lumen.Brush.TextMuted}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Margin="0,16,0,-8">
          <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_TypeLabel}" />
          <ComboBox ItemsSource="{Binding StoreOptions}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_StoreLabel}" />
          <ComboBox ItemsSource="{Binding InstallOptions}" SelectedItem="{Binding SelectedInstall}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_StateLabel}" />
          <ComboBox ItemsSource="{Binding CollectionOptions}" SelectedItem="{Binding SelectedCollection}" DisplayMemberPath="Label" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Filter_CollectionLabel}" />
          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" MinWidth="180" Margin="0,0,12,8" AutomationProperties.Name="{l:Loc Sort_Label}" />
          <Button Command="{Binding ClearFiltersCommand}"
                  Content="{l:Loc Filter_Clear}"
                  Style="{StaticResource Lumen.Button}"
                  Height="36"
                  Margin="0,0,12,8"
                  Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}" />
          <!-- Switches between the library and the items the user hid; only there once something is hidden. -->
          <Button Command="{Binding ToggleHiddenCommand}"
                  Style="{StaticResource Lumen.Button}"
                  Height="36"
                  Margin="0,0,12,8"
                  AutomationProperties.Name="{Binding HiddenToggleText}"
                  Visibility="{Binding HasHiddenToggle, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xED1A;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding HiddenToggleText}" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Non-blocking notice (scan problems, launch failures) -->
    <Border Grid.Row="2"
            Margin="0,0,24,16"
            Padding="14,10"
            CornerRadius="10"
            Background="{DynamicResource Lumen.Brush.Glass}"
            BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}"
            BorderThickness="1"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Lumen.Text.Icon}" Foreground="{DynamicResource Lumen.Brush.Warning}" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" />
      </DockPanel>
    </Border>

    <!-- Empty states: nothing in the library at all, or nothing matching the filters. ZIndex keeps them above
         the (empty, but hit-testable) grid that shares this row, so anything clickable here gets the mouse. -->
    <TextBlock Grid.Row="3"
               Panel.ZIndex="1"
               Text="{l:Loc Library_Empty}"
               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
               FontSize="{StaticResource Lumen.FontSize.Lead}"
               TextWrapping="Wrap"
               MaxWidth="520"
               HorizontalAlignment="Left"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    <!-- "Clear filters" lives in the filter bar only; a second copy here was redundant. -->
    <TextBlock Grid.Row="3"
               Panel.ZIndex="1"
               Text="{l:Loc Library_NoMatches}"
               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
               FontSize="{StaticResource Lumen.FontSize.Lead}"
               HorizontalAlignment="Left"
               Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />

    <!-- Grid of covers: a virtualized list of rows (WPF has no virtualizing wrap panel), so only rows on
         screen and their images exist in memory. The view sets ColumnCount from its width. -->
    <ItemsControl x:Name="RowsHost"
                  Grid.Row="3"
                  Margin="-20,-20,0,0"
                  ItemsSource="{Binding Rows}"
                  SizeChanged="OnGridSizeChanged"
                  Focusable="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsPresenter Margin="0,0,0,24" />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:TileRow}">
          <!-- The virtualizing panel clips to its own bounds, so the room a pointed-at cover needs (scaled up, with its glow)
               is inside the row and the tile: 12 px above and to the left of the row, 8 px round every tile. The grid's negative margin and the tiles' smaller bottom
               margin cancel it, so the layout is unchanged. -->
          <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False" Margin="12,12,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
  </Grid>
</UserControl>
