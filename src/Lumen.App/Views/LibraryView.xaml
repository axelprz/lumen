<UserControl x:Class="Lumen.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- Edit/remove menu, only attached to manual items' tiles. -->
    <ContextMenu x:Key="ManualTileMenu" x:Shared="False">
      <MenuItem Header="{l:Loc Tile_Edit}" Command="{Binding EditCommand}" />
      <MenuItem Header="{l:Loc Tile_Remove}" Command="{Binding RemoveCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid Margin="40,32,16,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,24,20" LastChildFill="True">
      <Button DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Margin="12,0,0,0"
              Command="{Binding AddManualItemCommand}"
              Style="{StaticResource Lumen.Button}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{l:Loc Library_Add}" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Command="{Binding RescanCommand}"
              Style="{StaticResource Lumen.Button}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{l:Loc Library_Rescan}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Text" Value="{l:Loc Library_Scanning}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="{l:Loc Nav_Library}" Style="{StaticResource Lumen.Text.PageTitle}" />
        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Lumen.Brush.TextMuted}" FontSize="14" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Non-blocking notice (scan problems, launch failures) -->
    <Border Grid.Row="1"
            Margin="0,0,24,16"
            Padding="14,10"
            CornerRadius="6"
            Background="{DynamicResource Lumen.Brush.Surface}"
            BorderBrush="{DynamicResource Lumen.Brush.Divider}"
            BorderThickness="1"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Lumen.Text.Icon}" Foreground="#FFE0B44C" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" />
      </DockPanel>
    </Border>

    <!-- Empty state -->
    <TextBlock Grid.Row="2"
               Text="{l:Loc Library_Empty}"
               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
               FontSize="15"
               TextWrapping="Wrap"
               MaxWidth="520"
               HorizontalAlignment="Left"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <!-- Grid of covers. Virtualization arrives with the full Library view in M3. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,0,0,24">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LibraryTileViewModel}">
            <Border x:Name="Tile" Width="168" Margin="0,0,20,24" Background="Transparent" ToolTip="{Binding Title}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                      <Setter Property="ContextMenu" Value="{StaticResource ManualTileMenu}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PrimaryCommand}" />
              </Border.InputBindings>
              <StackPanel>
                <Border x:Name="Cover" Height="252" CornerRadius="8" ClipToBounds="True">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FF232836" Offset="0" />
                      <GradientStop Color="#FF171A22" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid>
                    <TextBlock Text="{Binding Initial}"
                               FontSize="72"
                               FontWeight="Light"
                               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,0,40" />
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Padding="8,3"
                            CornerRadius="4"
                            Background="#B30F1115">
                      <TextBlock Text="{Binding StoreName}" FontSize="11" Foreground="{DynamicResource Lumen.Brush.Text}" />
                    </Border>
                    <Button VerticalAlignment="Bottom"
                            Margin="10"
                            Command="{Binding PrimaryCommand}"
                            Content="{Binding ActionText}"
                            Style="{StaticResource Lumen.Button.Tile}" />
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Title}"
                           Margin="2,10,2,0"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           MaxHeight="40" />
                <TextBlock Text="{Binding StateText}"
                           Margin="2,2,2,0"
                           FontSize="12"
                           Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                <Setter TargetName="Cover" Property="Opacity" Value="0.5" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
