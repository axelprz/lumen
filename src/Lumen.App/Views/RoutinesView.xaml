<!-- Routines page (RoutinesViewModel): list, run/undo, trust preview and the simple editor (both cover the page). -->
<UserControl x:Class="Lumen.App.Views.RoutinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             xmlns:services="clr-namespace:Lumen.App.Services">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- A step line: number, sentence, warnings. Highlighted steps get the warning color; blocked ones the error color. -->
    <DataTemplate x:Key="StepLineTemplate" DataType="{x:Type vm:StepLine}">
      <DockPanel Margin="0,0,0,10">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="26" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        <StackPanel>
          <TextBlock Text="{Binding Text}" FontSize="{StaticResource Lumen.FontSize.Lead}" TextWrapping="Wrap" />
          <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
          <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Trust preview -->
    <DataTemplate DataType="{x:Type vm:RoutineReviewViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="{l:Loc Routine_Review_Title}" FontSize="{StaticResource Lumen.FontSize.Body}" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          <TextBlock Text="{Binding Name}" Style="{StaticResource Lumen.Text.PageTitle}" Margin="0,4,0,8" />
          <TextBlock Text="{Binding Hint}" FontSize="{StaticResource Lumen.FontSize.Body}" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />

          <Border Style="{StaticResource Lumen.Card}" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{l:Loc Routine_Review_Errors}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold" Foreground="{DynamicResource Lumen.Brush.Error}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Errors}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Consolas" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Lumen.Card}" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepLineTemplate}" Focusable="False" />
          </Border>

          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding DataContext.ApproveAndRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Content="{l:Loc Routine_ApproveAndRun}" Style="{StaticResource Lumen.Button.Primary}"
                    Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
            <Button Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Content="{l:Loc Routine_Approve}" Style="{StaticResource Lumen.Button}"
                    Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
            <Button Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{l:Loc Routine_Close}" Style="{StaticResource Lumen.Button}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- Editor -->
    <DataTemplate DataType="{x:Type vm:RoutineEditorViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="{l:Loc Routine_Editor_Title}" Style="{StaticResource Lumen.Text.PageTitle}" Margin="0,0,0,20" />

          <TextBlock Text="{l:Loc Routine_Editor_Name}" Style="{StaticResource Lumen.Text.Label}" />
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Height="36" Padding="8,0"
                   VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc Routine_Editor_Name}" />

          <!-- Steps -->
          <TextBlock Text="{l:Loc Routine_Editor_Steps}" FontSize="{StaticResource Lumen.FontSize.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,8" />
          <TextBlock Text="{l:Loc Routine_Editor_NoSteps}" FontSize="{StaticResource Lumen.FontSize.Body}" Foreground="{DynamicResource Lumen.Brush.TextMuted}" Margin="0,0,0,8">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasSteps}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:EditorStep}">
                <Border Style="{StaticResource Lumen.Card}" Padding="14,10" Margin="0,0,0,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource Lumen.Button}" Margin="8,0,0,0"
                              Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{l:Loc Routine_MoveUp}" ToolTip="{l:Loc Routine_MoveUp}" />
                      <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource Lumen.Button}" Margin="4,0,0,0"
                              Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{l:Loc Routine_MoveDown}" ToolTip="{l:Loc Routine_MoveDown}" />
                      <Button Content="{l:Loc Routine_RemoveStep}" Style="{StaticResource Lumen.Button}" Margin="4,0,0,0"
                              Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <ContentPresenter Content="{Binding Line}" ContentTemplate="{StaticResource StepLineTemplate}" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Add a step -->
          <Border Style="{StaticResource Lumen.Card}" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="{l:Loc Routine_Editor_AddStep}" Style="{StaticResource Lumen.Text.Label}" />
              <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label" MinWidth="260"
                        HorizontalAlignment="Left" AutomationProperties.Name="{l:Loc Routine_Editor_AddStep}" />

              <!-- Library item (open or close) -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding IsItemKind, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:Loc Routine_Editor_SearchLibrary}" />
                <TextBlock Text="{l:Loc Routine_Editor_SearchLibrary}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="2,4,0,6" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                <ItemsControl ItemsSource="{Binding ItemResults}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Title}" Style="{StaticResource Lumen.Button}" HorizontalAlignment="Left" Margin="0,0,0,6"
                              Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Program by path -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding IsProgramKind, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Command="{Binding BrowseProgramCommand}" Content="{l:Loc Routine_Editor_Browse}"
                          Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
                  <TextBox Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                           AutomationProperties.Name="{l:Loc Routine_Editor_ProgramPath}" />
                </DockPanel>
                <TextBlock Text="{l:Loc Routine_Editor_Arguments}" Style="{StaticResource Lumen.Text.Label}" Margin="0,10,0,0" />
                <TextBox Text="{Binding ProgramArguments, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:Loc Routine_Editor_Arguments}" />
                <Button Command="{Binding AddProgramCommand}" Content="{l:Loc Routine_Editor_Add}" Style="{StaticResource Lumen.Button}"
                        HorizontalAlignment="Left" Margin="0,10,0,0" />
              </StackPanel>

              <!-- Web page -->
              <DockPanel Margin="0,12,0,0" Visibility="{Binding IsUrlKind, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Command="{Binding AddUrlCommand}" Content="{l:Loc Routine_Editor_Add}" Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
                <TextBox Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:Loc Routine_Kind_Url}" />
              </DockPanel>

              <!-- Folder -->
              <Button Margin="0,12,0,0" Command="{Binding AddFolderCommand}" Content="{l:Loc Routine_Editor_PickFolder}" Style="{StaticResource Lumen.Button}"
                      HorizontalAlignment="Left" Visibility="{Binding IsFolderKind, Converter={StaticResource BoolToVisibility}}" />

              <!-- Wait -->
              <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Visibility="{Binding IsWaitKind, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding WaitSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:Loc Routine_Editor_Seconds}" />
                <TextBlock Text="{l:Loc Routine_Editor_Seconds}" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="{StaticResource Lumen.FontSize.Body}" />
                <Button Command="{Binding AddWaitCommand}" Content="{l:Loc Routine_Editor_Add}" Style="{StaticResource Lumen.Button}" />
              </StackPanel>

              <!-- Close a program by name -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCloseProgramKind, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:Loc Routine_Editor_ProcessName}" />
                <TextBlock Text="{l:Loc Routine_Editor_ProcessName}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="2,4,0,6" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                <CheckBox IsChecked="{Binding ForceClose}" Content="{l:Loc Routine_Editor_Force}" FontSize="{StaticResource Lumen.FontSize.Body}" Foreground="{DynamicResource Lumen.Brush.Text}" />
                <Button Command="{Binding AddCloseProgramCommand}" Content="{l:Loc Routine_Editor_Add}" Style="{StaticResource Lumen.Button}"
                        HorizontalAlignment="Left" Margin="0,10,0,0" />
              </StackPanel>

              <TextBlock Text="{Binding Problem}" FontSize="{StaticResource Lumen.FontSize.Body}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Lumen.Brush.Warning}"
                         Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Border>

          <!-- Options and save -->
          <CheckBox IsChecked="{Binding StopOnError}" Content="{l:Loc Routine_Editor_StopOnError}" FontSize="{StaticResource Lumen.FontSize.Body}" Margin="0,20,0,0"
                    Foreground="{DynamicResource Lumen.Brush.Text}" />
          <CheckBox IsChecked="{Binding Pinned}" Content="{l:Loc Routine_Editor_Pinned}" FontSize="{StaticResource Lumen.FontSize.Body}" Margin="0,8,0,0"
                    Foreground="{DynamicResource Lumen.Brush.Text}" />
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Command="{Binding SaveCommand}" Content="{l:Loc Routine_Editor_Save}" Style="{StaticResource Lumen.Button.Primary}" Margin="0,0,8,0" />
            <Button Command="{Binding CancelCommand}" Content="{l:Loc Detail_Cancel}" Style="{StaticResource Lumen.Button}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Loaded="OnLoaded">
    <!-- Preview / editor cover the list while open -->
    <ContentControl Panel.ZIndex="5" services:GamepadLayer.Priority="1" Content="{Binding Panel}" Focusable="False"
                    Background="{DynamicResource Lumen.Brush.Background}"
                    Visibility="Collapsed"
                    services:Motion.Shown="{Binding HasPanel}" />
    <Border Panel.ZIndex="4" Background="{DynamicResource Lumen.Brush.Background}"
            Visibility="{Binding HasPanel, Converter={StaticResource BoolToVisibility}}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="PageBlocks" Margin="40,28,40,40" MaxWidth="1100" HorizontalAlignment="Left">
        <!-- Title and explanation; the page's actions on the right -->
        <DockPanel Margin="0,0,0,24">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource Lumen.Button}" Margin="0,0,10,0"
                    AutomationProperties.Name="{l:Loc Routine_OpenFolder}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE838;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
                <TextBlock Text="{l:Loc Routine_OpenFolder}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ImportCommand}" Style="{StaticResource Lumen.Button}" Margin="0,0,10,0"
                    AutomationProperties.Name="{l:Loc Routine_Import}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B5;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
                <TextBlock Text="{l:Loc Routine_Import}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding NewCommand}" Style="{StaticResource Lumen.Button.Primary}"
                    AutomationProperties.Name="{l:Loc Routine_New}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
                <TextBlock Text="{l:Loc Routine_New}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{l:Loc Nav_Routines}" FontSize="{StaticResource Lumen.FontSize.Title}" FontWeight="Bold" />
            <TextBlock Text="{l:Loc Routine_Body}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          </StackPanel>
        </DockPanel>

        <Border Margin="0,0,0,16" Padding="14,10" CornerRadius="10" HorizontalAlignment="Left"
                Background="{DynamicResource Lumen.Brush.Glass}" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}" BorderThickness="1"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" />
        </Border>

        <TextBlock Text="{l:Loc Routine_Empty}" FontSize="{StaticResource Lumen.FontSize.Lead}" TextWrapping="Wrap" Foreground="{DynamicResource Lumen.Brush.TextMuted}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasRoutines}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- One glass row per routine: icon, name, steps as a chain, state; Run (or Review) and the less used actions as icons -->
        <ItemsControl ItemsSource="{Binding Routines}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RoutineCardViewModel}">
              <Border Style="{StaticResource Lumen.Card}" Padding="18,16" Margin="0,0,0,12">
                <DockPanel>
                  <Border x:Name="IconBox" DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="14" VerticalAlignment="Top" Margin="0,0,16,0"
                          Background="{DynamicResource Lumen.Brush.BrandSoft}" BorderBrush="{DynamicResource Lumen.Brush.BrandBorder}" BorderThickness="1">
                    <TextBlock x:Name="IconGlyph" Text="&#xE945;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Section}"
                               Foreground="{DynamicResource Lumen.Brush.BrandText}" HorizontalAlignment="Center" />
                  </Border>

                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                    <Button Style="{StaticResource Lumen.Button.Primary}" Margin="0,0,8,0" AutomationProperties.Name="{l:Loc Routine_Run}"
                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Routine_Run}" />
                      </StackPanel>
                    </Button>
                    <Button Content="{l:Loc Routine_Review}" Style="{StaticResource Lumen.Button.Primary}" Margin="0,0,8,0"
                            Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:Loc Routine_Details}" Style="{StaticResource Lumen.Button}" Margin="0,0,8,0"
                            Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:Loc Routine_Undo}" Style="{StaticResource Lumen.Button}" Margin="0,0,8,0"
                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:Loc Routine_ForceClose}" Style="{StaticResource Lumen.Button}" Margin="0,0,8,0"
                            Foreground="{DynamicResource Lumen.Brush.Warning}"
                            Command="{Binding DataContext.ForceCloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanForceClose, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="&#xE70F;" Style="{StaticResource Lumen.Button.Icon}" Margin="0,0,8,0"
                            ToolTip="{l:Loc Routine_Edit}" AutomationProperties.Name="{l:Loc Routine_Edit}"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="&#xE72D;" Style="{StaticResource Lumen.Button.Icon}" Margin="0,0,8,0"
                            ToolTip="{l:Loc Routine_Export}" AutomationProperties.Name="{l:Loc Routine_Export}"
                            Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="&#xE74D;" Style="{StaticResource Lumen.Button.Icon}"
                            ToolTip="{l:Loc Routine_Delete}" AutomationProperties.Name="{l:Loc Routine_Delete}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  </StackPanel>

                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lumen.FontSize.BodyLarge}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StepsText}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Lumen.Brush.Text}" Opacity="0.85"
                               Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,4,0,0" Foreground="{DynamicResource Lumen.Brush.TextMuted}">
                      <Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=" · " /><Run x:Name="State" Text="{Binding StateText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ResultText}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                  <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
                  <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                  <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
                  <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
