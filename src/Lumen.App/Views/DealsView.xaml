<UserControl x:Class="Lumen.App.Views.DealsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="Deals.SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Small}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.BrandText}" />
      <Setter Property="Margin" Value="0,22,0,12" />
    </Style>

    <!-- One free game: name and where on the left, when and the price on the right of the same card -->
    <DataTemplate x:Key="Deals.Row" DataType="{x:Type vm:DealRow}">
      <Border Style="{StaticResource Lumen.Card}" Padding="18,14" Margin="0,0,0,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Lumen.Button}" Margin="16,0,0,0" VerticalAlignment="Center"
                  Content="{l:Loc Deals_Open}"
                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding Title}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Lumen.Brush.TextMuted}">
              <Run Text="{Binding StoreText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding WorthText}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,2,0,0"
                       Foreground="{DynamicResource Lumen.Brush.TextMuted}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WorthText}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- One offer as a card: cover (Steam's CDN, or a quiet block when there is none), store and discount tags, name, price -->
    <DataTemplate x:Key="Deals.Card" DataType="{x:Type vm:PriceRow}">
      <Border Style="{StaticResource Lumen.Card}" Padding="0" Width="238" Margin="0,0,12,12">
        <StackPanel>
          <Grid Height="111">
            <Border Background="{DynamicResource Lumen.Brush.BrandSoft}" CornerRadius="15,15,0,0" />
            <Border CornerRadius="15,15,0,0">
              <Border.Background>
                <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border CornerRadius="15,15,0,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0.55" />
                  <GradientStop Color="#990A0D14" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Style="{StaticResource Lumen.Badge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
              <TextBlock Text="{Binding Store}" Style="{StaticResource Lumen.Text.Badge}" />
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Lumen.Pill}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DiscountText}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding DiscountText}" Style="{StaticResource Lumen.Text.Badge}" />
            </Border>
          </Grid>
          <DockPanel Margin="14,12,14,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource Lumen.Button}" Margin="10,0,0,0" VerticalAlignment="Bottom" Content="{l:Loc Deals_Open}"
                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Url}"
                    AutomationProperties.Name="{Binding Title}" />
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lumen.FontSize.Small}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
              <TextBlock Text="{Binding OldPriceText}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,6,0,0" TextDecorations="Strikethrough"
                         Foreground="{DynamicResource Lumen.Brush.TextMuted}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding OldPriceText}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Hidden" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding PriceText}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="Bold" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Deals.CardPanel">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- A store filter: the chosen one is the primary button -->
    <DataTemplate x:Key="Deals.Filter" DataType="{x:Type vm:DealFilter}">
      <Grid Margin="0,0,8,8">
        <Button Style="{StaticResource Lumen.Button}" Content="{Binding Label}" Padding="14,6"
                Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
        <Button Content="{Binding Label}" Padding="14,6"
                Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource Lumen.Button.Primary}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </DataTemplate>

    <!-- One game of a search: the best store and every store's price -->
    <DataTemplate x:Key="Deals.GameRow" DataType="{x:Type vm:PriceGameRow}">
      <Border Style="{StaticResource Lumen.Card}" Padding="18,14" Margin="0,0,0,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Lumen.Button}" Margin="16,0,0,0" VerticalAlignment="Center" Content="{l:Loc Deals_Open}"
                  Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Url}"
                  AutomationProperties.Name="{Binding Title}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding BestText}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StoresText}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,28,40,40" MaxWidth="1080">
      <DockPanel Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="{l:Loc Deals_Refresh}" Style="{StaticResource Lumen.Button}"
                VerticalAlignment="Center" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel>
          <TextBlock Text="{l:Loc Nav_Deals}" FontSize="{StaticResource Lumen.FontSize.Title}" FontWeight="Bold" />
          <TextBlock Text="{l:Loc Deals_Subtitle}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>
      </DockPanel>

      <!-- Off by default: say what it contacts before anything is requested -->
      <Border Style="{StaticResource Lumen.Card}" Padding="20,18" Margin="0,16,0,0"
              Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{l:Loc Deals_OptIn_Title}" FontSize="{StaticResource Lumen.FontSize.BodyLarge}" FontWeight="SemiBold" />
          <TextBlock Text="{l:Loc Deals_OptIn_Body}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,8,0,16"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          <Button Command="{Binding EnableCommand}" Content="{l:Loc Deals_OptIn_Enable}" Style="{StaticResource Lumen.Button.Primary}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
        <!-- Price search: only the typed text is sent -->
        <DockPanel Margin="0,18,0,0">
          <Button DockPanel.Dock="Right" Command="{Binding SearchCommand}" Content="{l:Loc Deals_Search_Button}" Style="{StaticResource Lumen.Button.Primary}" Margin="8,0,0,0" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Height="38" VerticalContentAlignment="Center" Padding="10,0"
                   AutomationProperties.Name="{l:Loc Deals_Search_Label}" ToolTip="{l:Loc Deals_Search_Label}">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </DockPanel>
        <TextBlock Text="{l:Loc Deals_Search_Hint}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        <TextBlock Text="{Binding SearchNoteText}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" Visibility="{Binding HasSearchNote, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource Deals.GameRow}" Focusable="False" Margin="0,12,0,0" />

        <TextBlock Text="{l:Loc Deals_Loading}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,16,0,0"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- The first free game right now, large -->
        <Border Margin="0,18,0,0" MinHeight="240" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}"
                Background="{DynamicResource Lumen.Brush.BrandSoft}" DataContext="{Binding Hero}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border CornerRadius="15">
            <Border.Background>
              <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" AlignmentY="Top" />
            </Border.Background>
            <Border CornerRadius="15" Padding="28" MinHeight="238">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#F20A0D14" Offset="0" />
                  <GradientStop Color="#B30A0D14" Offset="0.55" />
                  <GradientStop Color="#330A0D14" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel VerticalAlignment="Bottom" MaxWidth="520" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource Lumen.Pill}">
                    <TextBlock Text="{l:Loc Deals_Hero_Badge}" Style="{StaticResource Lumen.Text.Badge}" />
                  </Border>
                  <TextBlock Text="{Binding StoreText}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Lumen.FontSize.Caption}"
                             Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" Margin="0,12,0,0" FontSize="{StaticResource Lumen.FontSize.Headline}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" FontSize="{StaticResource Lumen.FontSize.Small}" Foreground="{DynamicResource Lumen.Brush.BrandText}" />
                <TextBlock Text="{Binding WorthText}" Margin="0,2,0,0" FontSize="{StaticResource Lumen.FontSize.Caption}" Foreground="{DynamicResource Lumen.Brush.TextMuted}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WorthText}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource Lumen.Button.Primary}" Content="{l:Loc Deals_Claim}" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title}" />
              </StackPanel>
            </Border>
          </Border>
        </Border>

        <TextBlock Text="{l:Loc Deals_FreeNow_More}" Style="{StaticResource Deals.SectionTitle}"
                   Visibility="{Binding HasFreeNow, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding FreeNow}" ItemTemplate="{StaticResource Deals.Row}" Focusable="False" />

        <TextBlock Text="{l:Loc Deals_Upcoming_Title}" Style="{StaticResource Deals.SectionTitle}"
                   Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource Deals.Row}" Focusable="False" />

        <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,12,0,0"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />

        <!-- Filters by store, then the offers as cards (only the stores Lumen supports) -->
        <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource Deals.Filter}" ItemsPanel="{StaticResource Deals.CardPanel}" Focusable="False" Margin="0,22,0,0"
                      Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{l:Loc Deals_Best_Title}" Style="{StaticResource Deals.SectionTitle}" Margin="0,10,0,12" Visibility="{Binding HasBestDeals, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding BestDeals}" ItemTemplate="{StaticResource Deals.Card}" ItemsPanel="{StaticResource Deals.CardPanel}" Focusable="False" />
        <!-- Steam's top sellers: what is popular right now, never paid placement -->
        <TextBlock Text="{l:Loc Deals_Trending_Title}" Style="{StaticResource Deals.SectionTitle}" Visibility="{Binding HasTopSellers, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding TopSellers}" ItemTemplate="{StaticResource Deals.Card}" ItemsPanel="{StaticResource Deals.CardPanel}" Focusable="False" />
        <TextBlock Text="{l:Loc Deals_PricesNote}" FontSize="{StaticResource Lumen.FontSize.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        <!-- CheapShark asks for a link back -->
        <DockPanel Margin="0,12,0,0">
          <TextBlock Text="{l:Loc Deals_PricesFrom}" FontSize="{StaticResource Lumen.FontSize.Caption}" VerticalAlignment="Center" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          <Button Command="{Binding OpenCheapSharkCommand}" Content="cheapshark.com" Style="{StaticResource Lumen.Button}" Padding="10,4" Margin="8,0,0,0"
                  FontSize="{StaticResource Lumen.FontSize.Caption}" HorizontalAlignment="Left" />
        </DockPanel>
      </StackPanel>

      <!-- Saving in Argentina: only links to Steamcito (opened in the browser), always shown -->
      <TextBlock Text="{l:Loc Deals_Saving_Title}" Style="{StaticResource Deals.SectionTitle}" Margin="0,30,0,12" />
      <Border Style="{StaticResource Lumen.Card}" Padding="20,18">
        <StackPanel>
          <TextBlock Text="{l:Loc Deals_Saving_Body}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Small}"
                     Foreground="{DynamicResource Lumen.Brush.Text}" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Command="{Binding OpenSteamcitoGuideCommand}" Content="{l:Loc Deals_Saving_OpenGuide}" Style="{StaticResource Lumen.Button.Primary}"
                    Margin="0,0,8,0" />
            <Button Command="{Binding OpenSteamcitoSiteCommand}" Content="{l:Loc Deals_Saving_OpenSite}" Style="{StaticResource Lumen.Button}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
