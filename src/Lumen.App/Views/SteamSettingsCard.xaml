<!-- Steam Web API key and SteamID64 (SteamSettingsViewModel). Used by Settings and the first-run wizard. -->
<UserControl x:Class="Lumen.App.Views.SteamSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc Settings_Steam_Title}" FontSize="{StaticResource Lumen.FontSize.Subtitle}" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc Settings_Steam_Description}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource Lumen.FontSize.Body}"
                 Margin="0,6,0,20" />

      <TextBlock Text="{l:Loc Settings_Steam_SteamIdLabel}" Style="{StaticResource Lumen.Text.Label}" />
      <TextBox Text="{Binding SteamIdInput, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="{l:Loc Settings_Steam_SteamIdHint}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource Lumen.FontSize.Caption}"
                 Margin="0,6,0,16" />

      <DockPanel Margin="0,0,0,6">
        <Button DockPanel.Dock="Right"
                Command="{Binding OpenApiKeyPageCommand}"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Foreground="{DynamicResource Lumen.Brush.BrandText}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <TextBlock Text="{l:Loc Settings_Steam_GetKey}" FontSize="{StaticResource Lumen.FontSize.Small}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock Text="{l:Loc Settings_Steam_KeyLabel}" Style="{StaticResource Lumen.Text.Label}" Margin="0" />
      </DockPanel>
      <PasswordBox x:Name="ApiKeyBox" />
      <TextBlock Text="{l:Loc Settings_Steam_KeyHint}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource Lumen.FontSize.Caption}"
                 Margin="0,6,0,0" />
      <TextBlock Text="{l:Loc Settings_Steam_KeySavedHint}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 FontSize="{StaticResource Lumen.FontSize.Caption}"
                 Margin="0,6,0,0"
                 Visibility="{Binding IsKeySaved, Converter={StaticResource BoolToVisibility}}" />

      <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
        <Button x:Name="SaveButton"
                Click="OnSaveClick"
                Content="{l:Loc Settings_Steam_SaveTest}"
                Style="{StaticResource Lumen.Button.Primary}"
                FontWeight="SemiBold"
                IsEnabled="{Binding SaveAndTestCommand.IsRunning, Converter={StaticResource InverseBool}}" />
        <Button Command="{Binding RemoveCommand}"
                Content="{l:Loc Settings_Steam_Remove}"
                Style="{StaticResource Lumen.Button}"
                Margin="12,0,0,0"
                Visibility="{Binding IsKeySaved, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource Lumen.FontSize.Body}"
                 Margin="0,16,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
