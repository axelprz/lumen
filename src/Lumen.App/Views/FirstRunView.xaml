<!-- First-run wizard, shown over the whole window (FirstRunViewModel). -->
<UserControl x:Class="Lumen.App.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             xmlns:views="clr-namespace:Lumen.App.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
    </Style>
    <Style x:Key="StepBody" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Lead}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,10,0,24" />
      <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Lumen.Brush.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: brand, progress, skip -->
    <DockPanel Grid.Row="0" Margin="48,28,48,0">
      <Button DockPanel.Dock="Right"
              Command="{Binding SkipCommand}"
              Content="{l:Loc FirstRun_Skip}"
              Style="{StaticResource Lumen.Button}"
              VerticalAlignment="Center" />
      <TextBlock DockPanel.Dock="Left" Text="{l:Loc App_Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding StepText}" Margin="20,0,0,0" FontSize="{StaticResource Lumen.FontSize.Body}" VerticalAlignment="Center"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid MaxWidth="720" Margin="48,40,48,24" HorizontalAlignment="Center">

        <!-- 1. Language -->
        <StackPanel Visibility="{Binding IsLanguageStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc FirstRun_Welcome_Title}" Style="{StaticResource StepTitle}" />
          <TextBlock Text="{l:Loc FirstRun_Welcome_Body}" Style="{StaticResource StepBody}" />
          <TextBlock Text="{l:Loc Settings_Language}" Style="{StaticResource Lumen.Text.Label}" />
          <ListBox DataContext="{Binding Language}"
                   ItemsSource="{Binding Options}"
                   SelectedItem="{Binding Selected}"
                   DisplayMemberPath="Label"
                   Style="{StaticResource Lumen.Sidebar.List}"
                   ItemContainerStyle="{StaticResource Lumen.Sidebar.Item}"
                   MaxWidth="360"
                   HorizontalAlignment="Left"
                   AutomationProperties.Name="{l:Loc Settings_Language}" />
        </StackPanel>

        <!-- 2. Stores found -->
        <StackPanel Visibility="{Binding IsStoresStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc FirstRun_Stores_Title}" Style="{StaticResource StepTitle}" />
          <TextBlock Text="{l:Loc FirstRun_Stores_Body}" Style="{StaticResource StepBody}" />
          <TextBlock Text="{Binding StoresSummary}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ItemsControl ItemsSource="{Binding Stores}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StoreRow}">
                <Border Style="{StaticResource Lumen.Card}" Padding="16,12" Margin="0,0,0,8">
                  <DockPanel>
                    <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Lumen.Text.Icon}"
                               Foreground="{DynamicResource Lumen.Brush.Success}" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="{StaticResource Lumen.FontSize.Body}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsFound}" Value="False">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE738;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:Loc FirstRun_Stores_Hint}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,12,0,0"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>

        <!-- 3. Optional keys: the same cards as Settings -->
        <StackPanel Visibility="{Binding IsKeysStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc FirstRun_Keys_Title}" Style="{StaticResource StepTitle}" />
          <TextBlock Text="{l:Loc FirstRun_Keys_Body}" Style="{StaticResource StepBody}" />
          <views:SteamSettingsCard DataContext="{Binding Steam}" />
          <views:ArtworkSettingsCard DataContext="{Binding Artwork}" Margin="0,20,0,0" />
        </StackPanel>

        <!-- 4. Apps: the same list as "Discover apps" -->
        <views:DiscoverAppsView DataContext="{Binding Apps}"
                                Visibility="{Binding DataContext.IsAppsStep, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

        <!-- 5. Done -->
        <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc FirstRun_Done_Title}" Style="{StaticResource StepTitle}" />
          <TextBlock Text="{l:Loc FirstRun_Done_Body}" Style="{StaticResource StepBody}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Footer: back / next -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Lumen.Brush.Divider}" BorderThickness="0,1,0,0" Padding="48,16">
      <DockPanel MaxWidth="720">
        <Button DockPanel.Dock="Right"
                Command="{Binding NextCommand}"
                Content="{Binding NextText}"
                Style="{StaticResource Lumen.Button.Primary}"
                FontWeight="SemiBold"
                Padding="28,9" />
        <Button DockPanel.Dock="Left"
                Command="{Binding BackCommand}"
                Content="{l:Loc FirstRun_Back}"
                HorizontalAlignment="Left">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource Lumen.Button}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirstStep}" Value="True">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
