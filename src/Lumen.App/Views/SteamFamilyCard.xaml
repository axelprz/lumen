<!-- Settings → Steam family (SteamFamilyViewModel): sign in on Steam's own website, what Lumen does with it, disconnect. -->
<UserControl x:Class="Lumen.App.Views.SteamFamilyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc SteamFamily_Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc SteamWeb_Description}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,16"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />

      <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
        <Button Command="{Binding ConnectCommand}" Content="{l:Loc SteamWeb_SignIn}" HorizontalAlignment="Left"
                Style="{StaticResource Lumen.Button}" Background="{DynamicResource Lumen.Brush.Accent}"
                BorderBrush="{DynamicResource Lumen.Brush.Accent}" Foreground="White" FontWeight="SemiBold" />
        <TextBlock Text="{l:Loc SteamWeb_HowItWorks}" TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
      </StackPanel>

      <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding AccountText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{l:Loc SteamWeb_WhatLumenDoes}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,16"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding DisconnectCommand}" Content="{l:Loc SteamFamily_Disconnect}" Style="{StaticResource Lumen.Button}" />
          <Button Command="{Binding ConnectCommand}" Content="{l:Loc SteamWeb_SignInAgain}" Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
