<!-- Settings → Steam family (SteamFamilyViewModel): pick family members; their public games are read with the user's key. No sign-in. -->
<UserControl x:Class="Lumen.App.Views.SteamFamilyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc SteamFamily_Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc SteamFamily_HowItWorks}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,16"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />

      <TextBlock Text="{l:Loc SteamFamily_NeedsKey}" TextWrapping="Wrap" FontSize="14"
                 Foreground="{DynamicResource Lumen.Brush.Warning}"
                 Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVisibility}}" />

      <StackPanel Visibility="{Binding HasKey, Converter={StaticResource BoolToVisibility}}">
        <!-- Current members -->
        <ItemsControl ItemsSource="{Binding Members}" Focusable="False"
                      Visibility="{Binding HasMembers, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FamilyMemberOption}">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="{l:Loc SteamFamily_Remove}" Style="{StaticResource Lumen.Button}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Command="{Binding PickFromFriendsCommand}" Content="{l:Loc SteamFamily_PickFriends}" HorizontalAlignment="Left"
                Style="{StaticResource Lumen.Button}" Background="{DynamicResource Lumen.Brush.Accent}"
                BorderBrush="{DynamicResource Lumen.Brush.Accent}" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"
                Visibility="{Binding IsNotPicking, Converter={StaticResource BoolToVisibility}}" />

        <!-- Picking from the friend list -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsPicking, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc SteamFamily_PickHint}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Friends}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FamilyMemberOption}">
                  <CheckBox IsChecked="{Binding IsMember}" Content="{Binding Name}" Margin="0,0,0,8" FontSize="14"
                            Foreground="{DynamicResource Lumen.Brush.Text}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Command="{Binding SavePickCommand}" Content="{l:Loc SteamFamily_SavePick}" Style="{StaticResource Lumen.Button}"
                    Background="{DynamicResource Lumen.Brush.Accent}" BorderBrush="{DynamicResource Lumen.Brush.Accent}" Foreground="White" />
            <Button Command="{Binding CancelPickCommand}" Content="{l:Loc Detail_Cancel}" Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Or by profile link -->
        <TextBlock Text="{l:Loc SteamFamily_ProfileLabel}" Style="{StaticResource Lumen.Text.Label}" Margin="0,16,0,0" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Command="{Binding AddByProfileCommand}" Content="{l:Loc SteamFamily_Add}"
                  Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
          <TextBox Text="{Binding ProfileInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0"
                   VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc SteamFamily_ProfileLabel}">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding AddByProfileCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </DockPanel>

        <TextBlock Text="{l:Loc SteamFamily_WhatLumenReads}" TextWrapping="Wrap" FontSize="13" Margin="0,16,0,0"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
