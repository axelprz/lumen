<!-- Settings → Steam family library (SteamFamilyViewModel): QR sign-in, what Lumen can do, disconnect. -->
<UserControl x:Class="Lumen.App.Views.SteamFamilyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc SteamFamily_Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc SteamFamily_Description}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,16"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />

      <!-- Not connected -->
      <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
        <Button Command="{Binding ConnectCommand}" Content="{l:Loc SteamFamily_Connect}" HorizontalAlignment="Left"
                Style="{StaticResource Lumen.Button}" Background="{DynamicResource Lumen.Brush.Accent}"
                BorderBrush="{DynamicResource Lumen.Brush.Accent}" Foreground="White" FontWeight="SemiBold" />
      </StackPanel>

      <!-- QR: approve on the phone -->
      <StackPanel Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="8" Margin="0,0,20,0">
            <Image Source="{Binding QrImage}" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   AutomationProperties.Name="{l:Loc SteamFamily_QrName}" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:Loc SteamFamily_Steps}" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
            <Button Command="{Binding CancelConnectCommand}" Content="{l:Loc Detail_Cancel}" HorizontalAlignment="Left"
                    Style="{StaticResource Lumen.Button}" Margin="0,16,0,0" />
          </StackPanel>
        </DockPanel>
      </StackPanel>

      <!-- Connected: who, since when, what Lumen can do -->
      <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding AccountText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{l:Loc SteamFamily_WhatLumenCanDo}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,16"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        <Button Command="{Binding DisconnectCommand}" Content="{l:Loc SteamFamily_Disconnect}" HorizontalAlignment="Left"
                Style="{StaticResource Lumen.Button}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
