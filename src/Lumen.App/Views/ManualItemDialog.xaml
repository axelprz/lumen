<Window x:Class="Lumen.App.Views.ManualItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lumen.App.Localization"
        Title="{Binding WindowTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Lumen.Brush.Sidebar}"
        Foreground="{DynamicResource Lumen.Brush.Text}"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=TitleBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="KindRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
      <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Body}" />
      <Setter Property="Margin" Value="0,0,20,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <RadioButton Content="{l:Loc Manual_KindGame}" IsChecked="{Binding IsGame}" Style="{StaticResource KindRadio}" GroupName="Kind" />
      <RadioButton Content="{l:Loc Manual_KindApp}" IsChecked="{Binding IsGame, Converter={StaticResource InverseBool}}" Style="{StaticResource KindRadio}" GroupName="Kind" />
    </StackPanel>

    <TextBlock Text="{l:Loc Manual_TitleLabel}" Style="{StaticResource Lumen.Text.Label}" />
    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,16" />

    <TextBlock Text="{l:Loc Manual_TargetLabel}" Style="{StaticResource Lumen.Text.Label}" />
    <DockPanel Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="{l:Loc Manual_Browse}" Command="{Binding BrowseCommand}" Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
      <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>

    <TextBlock Text="{l:Loc Manual_ArgsLabel}" Style="{StaticResource Lumen.Text.Label}" />
    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ArgumentsEnabled}" MaxLength="2000" />

    <TextBlock Text="{Binding Error}"
               Foreground="{DynamicResource Lumen.Brush.Error}"
               TextWrapping="Wrap"
               FontSize="{StaticResource Lumen.FontSize.Body}"
               Margin="0,16,0,0"
               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="{l:Loc Manual_Cancel}" IsCancel="True" Style="{StaticResource Lumen.Button}" />
      <Button Content="{l:Loc Manual_Save}"
              Command="{Binding SaveCommand}"
              IsDefault="True"
              Style="{StaticResource Lumen.Button.Primary}"
              FontWeight="SemiBold"
              Margin="12,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
