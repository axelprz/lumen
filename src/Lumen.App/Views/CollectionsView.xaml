<!-- Collections page (CollectionsViewModel). -->
<UserControl x:Class="Lumen.App.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{l:Loc Nav_Collections}" Style="{StaticResource Lumen.Text.PageTitle}" />
      <TextBlock Text="{l:Loc Collections_Body}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,24"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />

      <!-- New collection -->
      <DockPanel Margin="0,0,0,20">
        <Button DockPanel.Dock="Right"
                Command="{Binding CreateCommand}"
                Content="{l:Loc Collections_Create}"
                Style="{StaticResource Lumen.Button}"
                Background="{DynamicResource Lumen.Brush.Accent}"
                BorderBrush="{DynamicResource Lumen.Brush.Accent}"
                Foreground="White"
                Margin="12,0,0,0" />
        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="80" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                 AutomationProperties.Name="{l:Loc Collections_NewName}">
          <TextBox.InputBindings>
            <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
          </TextBox.InputBindings>
        </TextBox>
      </DockPanel>

      <Border Margin="0,0,0,16" Padding="14,10" CornerRadius="6" HorizontalAlignment="Left"
              Background="{DynamicResource Lumen.Brush.Surface}" BorderBrush="{DynamicResource Lumen.Brush.Divider}" BorderThickness="1"
              Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" />
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:CollectionCard}">
            <Border Style="{StaticResource Lumen.Card}" Padding="18,14" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{l:Loc Collections_Open}"
                            Style="{StaticResource Lumen.Button}"
                            Margin="8,0,0,0" />
                    <Button Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{l:Loc Collections_Rename}"
                            Style="{StaticResource Lumen.Button}"
                            Margin="8,0,0,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{l:Loc Collections_Delete}"
                            Style="{StaticResource Lumen.Button}"
                            Margin="8,0,0,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="&#xE8F1;" Style="{StaticResource Lumen.Text.Icon}"
                             FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountText}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                  </StackPanel>
                </DockPanel>

                <!-- Inline rename -->
                <DockPanel Margin="0,12,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                  <Button DockPanel.Dock="Right"
                          Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Content="{l:Loc Detail_Cancel}"
                          Style="{StaticResource Lumen.Button}"
                          Margin="8,0,0,0" />
                  <Button DockPanel.Dock="Right"
                          Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Content="{l:Loc Detail_Save}"
                          Style="{StaticResource Lumen.Button}"
                          Background="{DynamicResource Lumen.Brush.Accent}"
                          BorderBrush="{DynamicResource Lumen.Brush.Accent}"
                          Foreground="White"
                          Margin="8,0,0,0" />
                  <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="80" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                           AutomationProperties.Name="{l:Loc Collections_Rename}" />
                </DockPanel>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                <Setter TargetName="Icon" Property="Text" Value="&#xE735;" />
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
