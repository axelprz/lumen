<!-- Collections page (CollectionsViewModel): tinted cards in a grid. -->
<UserControl x:Class="Lumen.App.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- Soft tints for the cards (Favorites is amber); kept low so the page stays calm. -->
    <LinearGradientBrush x:Key="Tint0" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2E3B82F6" Offset="0" />
      <GradientStop Color="#1F06B6D4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tint1" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2E8B5CF6" Offset="0" />
      <GradientStop Color="#1F6366F1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tint2" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2610B981" Offset="0" />
      <GradientStop Color="#1F14B8A6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintFavorites" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2EF59E0B" Offset="0" />
      <GradientStop Color="#1FF97316" Offset="1" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Loaded="OnLoaded">
    <StackPanel x:Name="PageBlocks" Margin="40,28,40,40" MaxWidth="1200" HorizontalAlignment="Left">
      <!-- Title and explanation; creating a collection sits on the right -->
      <DockPanel Margin="0,0,0,24">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
          <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                   Width="240" MaxLength="80" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                   AutomationProperties.Name="{l:Loc Collections_NewName}">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Command="{Binding CreateCommand}"
                  Style="{StaticResource Lumen.Button.Primary}"
                  Height="38"
                  Margin="10,0,0,0"
                  AutomationProperties.Name="{l:Loc Collections_Create}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
              <TextBlock Text="{l:Loc Collections_Create}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{l:Loc Nav_Collections}" FontSize="{StaticResource Lumen.FontSize.Title}" FontWeight="Bold" />
          <TextBlock Text="{l:Loc Collections_Body}" FontSize="{StaticResource Lumen.FontSize.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>
      </DockPanel>

      <Border Margin="0,0,0,16" Padding="14,10" CornerRadius="10" HorizontalAlignment="Left"
              Background="{DynamicResource Lumen.Brush.Glass}" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}" BorderThickness="1"
              Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" />
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Margin="0,0,-16,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:CollectionCard}">
            <Border x:Name="Card" CornerRadius="16" BorderThickness="1" Padding="20,18" Margin="0,0,16,16"
                    Background="{StaticResource Tint0}" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}">
              <StackPanel>
                <!-- Folder (or star) and the item count -->
                <DockPanel>
                  <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="6" Padding="9,3" Background="{DynamicResource Lumen.Brush.FillHover}">
                    <TextBlock Text="{Binding CountText}" FontSize="{StaticResource Lumen.FontSize.Label}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Lumen.Brush.Text}" />
                  </Border>
                  <TextBlock x:Name="Icon" Text="&#xE8B7;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Headline}"
                             Foreground="#CCFFFFFF" HorizontalAlignment="Left" />
                </DockPanel>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lumen.FontSize.BodyLarge}" FontWeight="Bold" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />

                <!-- Open, rename, delete -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource Lumen.Button}"
                          Background="#1AFFFFFF"
                          Padding="14,7"
                          AutomationProperties.Name="{l:Loc Collections_Open}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8A7;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="0,0,8,0" />
                      <TextBlock Text="{l:Loc Collections_Open}" FontWeight="SemiBold" FontSize="{StaticResource Lumen.FontSize.Small}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Content="&#xE8AC;"
                          Style="{StaticResource Lumen.Button.Icon}"
                          Padding="9"
                          Margin="8,0,0,0"
                          ToolTip="{l:Loc Collections_Rename}"
                          AutomationProperties.Name="{l:Loc Collections_Rename}"
                          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                  <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Content="&#xE74D;"
                          Style="{StaticResource Lumen.Button.Icon}"
                          Padding="9"
                          Margin="8,0,0,0"
                          ToolTip="{l:Loc Collections_Delete}"
                          AutomationProperties.Name="{l:Loc Collections_Delete}"
                          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Inline rename -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                  <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="80" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                           AutomationProperties.Name="{l:Loc Collections_Rename}" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{l:Loc Detail_Save}"
                            Style="{StaticResource Lumen.Button.Primary}" />
                    <Button Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{l:Loc Detail_Cancel}"
                            Style="{StaticResource Lumen.Button}"
                            Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Tint}" Value="1">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource Tint1}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Tint}" Value="2">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource Tint2}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource TintFavorites}" />
                <Setter TargetName="Icon" Property="Text" Value="&#xE735;" />
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
