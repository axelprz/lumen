<!-- Settings → Epic Games account (EpicAccountViewModel): browser sign-in + pasted code, what Lumen can do, disconnect. -->
<UserControl x:Class="Lumen.App.Views.EpicAccountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc EpicAccount_Title}" FontSize="{StaticResource Lumen.FontSize.Subtitle}" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc EpicAccount_Description}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" Margin="0,6,0,16"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />

      <!-- Not connected -->
      <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
        <Button Command="{Binding OpenSignInCommand}" Content="{l:Loc EpicAccount_SignIn}" HorizontalAlignment="Left"
                Style="{StaticResource Lumen.Button}" Background="{DynamicResource Lumen.Brush.Accent}"
                BorderBrush="{DynamicResource Lumen.Brush.Accent}" Foreground="White" FontWeight="SemiBold" />

        <!-- After the browser opens: paste the code -->
        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsEnteringCode, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc EpicAccount_Steps}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" LineHeight="22" Margin="0,0,0,12" />
          <TextBlock Text="{l:Loc EpicAccount_CodeLabel}" Style="{StaticResource Lumen.Text.Label}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding CancelSignInCommand}" Content="{l:Loc Detail_Cancel}"
                    Style="{StaticResource Lumen.Button}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Command="{Binding ConnectCommand}" Content="{l:Loc EpicAccount_Connect}"
                    Style="{StaticResource Lumen.Button}" Background="{DynamicResource Lumen.Brush.Accent}"
                    BorderBrush="{DynamicResource Lumen.Brush.Accent}" Foreground="White" Margin="8,0,0,0"
                    IsEnabled="{Binding ConnectCommand.IsRunning, Converter={StaticResource InverseBool}}" />
            <TextBox Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0"
                     VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc EpicAccount_CodeLabel}">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding ConnectCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
        </StackPanel>
      </StackPanel>

      <!-- Connected -->
      <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding AccountText}" FontSize="{StaticResource Lumen.FontSize.Lead}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{l:Loc EpicAccount_WhatLumenCanDo}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,8,0,16"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        <Button Command="{Binding DisconnectCommand}" Content="{l:Loc SteamFamily_Disconnect}" HorizontalAlignment="Left"
                Style="{StaticResource Lumen.Button}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" Margin="0,16,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
