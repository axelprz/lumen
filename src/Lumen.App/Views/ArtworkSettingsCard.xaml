<!-- SteamGridDB key and artwork cache (ArtworkSettingsViewModel). Used by Settings and the first-run wizard. -->
<UserControl x:Class="Lumen.App.Views.ArtworkSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc Settings_Artwork_Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc Settings_Artwork_Description}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="14"
                 Margin="0,6,0,20" />

      <DockPanel Margin="0,0,0,6">
        <Button DockPanel.Dock="Right"
                Command="{Binding OpenApiKeyPageCommand}"
                Cursor="Hand"
                Foreground="{DynamicResource Lumen.Brush.Accent}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <TextBlock Text="{l:Loc Settings_Sgdb_GetKey}" FontSize="13" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock Text="{l:Loc Settings_Sgdb_KeyLabel}" Style="{StaticResource Lumen.Text.Label}" Margin="0" />
      </DockPanel>
      <PasswordBox x:Name="SgdbKeyBox" />
      <TextBlock Text="{l:Loc Settings_Sgdb_KeySaved}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 FontSize="12"
                 Margin="0,6,0,0"
                 Visibility="{Binding IsKeySaved, Converter={StaticResource BoolToVisibility}}" />

      <WrapPanel Margin="0,20,0,0">
        <Button Click="OnSgdbSaveClick"
                Content="{l:Loc Settings_Steam_SaveTest}"
                Style="{StaticResource Lumen.Button}"
                Background="{DynamicResource Lumen.Brush.Accent}"
                BorderBrush="{DynamicResource Lumen.Brush.Accent}"
                Foreground="White"
                FontWeight="SemiBold"
                Margin="0,0,12,8"
                IsEnabled="{Binding SaveAndTestCommand.IsRunning, Converter={StaticResource InverseBool}}" />
        <Button Command="{Binding RemoveKeyCommand}"
                Content="{l:Loc Settings_Steam_Remove}"
                Style="{StaticResource Lumen.Button}"
                Margin="0,0,12,8"
                Visibility="{Binding IsKeySaved, Converter={StaticResource BoolToVisibility}}" />
        <Button Command="{Binding ClearCacheCommand}"
                Content="{l:Loc Settings_Artwork_ClearCache}"
                Style="{StaticResource Lumen.Button}"
                Margin="0,0,12,8" />
      </WrapPanel>

      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 FontSize="14"
                 Margin="0,8,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
