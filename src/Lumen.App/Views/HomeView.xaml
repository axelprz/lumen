<UserControl x:Class="Lumen.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             xmlns:conv="clr-namespace:Lumen.App.Converters"
             DataContextChanged="OnDataContextChanged">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ImagePathConverter x:Key="ImagePath" />
    <!-- A game in a Home row (Continue playing, Favorites): cover (or icon); pointing at it features it, click opens it -->
    <DataTemplate x:Key="HomeTile" DataType="{x:Type vm:HomeTileViewModel}">
      <StackPanel Width="150" Margin="0,0,18,12" ToolTip="{Binding Title}" Loaded="OnTileLoaded">
        <Button x:Name="Cover"
                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding Item}"
                Cursor="Hand"
                MouseEnter="OnTilePointed"
                GotKeyboardFocus="OnTilePointed"
                AutomationProperties.Name="{Binding Title}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Frame" Height="225" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF232836" Offset="0" />
                    <GradientStop Color="#FF171A22" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Grid>
            <Border CornerRadius="6">
              <Border.Background>
                <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePath}, ConverterParameter=300}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Image Source="{Binding IconPath, Converter={StaticResource ImagePath}, ConverterParameter=192}"
                   Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="Initial" Text="{Binding Initial}" FontSize="60" FontWeight="Light" Opacity="0.6"
                       Foreground="{DynamicResource Lumen.Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="13" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasCover}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Lumen.Brush.Background}" ClipToBounds="True">
    <!-- Background: the featured game's art, blurred. Two layers so a new game crossfades over the old one.
         Decoded small (it's blurred anyway), which keeps memory and the blur cheap. -->
    <Image x:Name="BackgroundA" Stretch="UniformToFill" Opacity="0" Margin="-60" IsHitTestVisible="False">
      <Image.Effect>
        <BlurEffect Radius="40" KernelType="Gaussian" RenderingBias="Performance" />
      </Image.Effect>
    </Image>
    <Image x:Name="BackgroundB" Stretch="UniformToFill" Opacity="0" Margin="-60" IsHitTestVisible="False">
      <Image.Effect>
        <BlurEffect Radius="40" KernelType="Gaussian" RenderingBias="Performance" />
      </Image.Effect>
    </Image>
    <!-- Darkening so text stays readable over any artwork -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#590F1115" Offset="0" />
          <GradientStop Color="#990F1115" Offset="0.45" />
          <GradientStop Color="#F20F1115" Offset="0.8" />
          <GradientStop Color="#FF0F1115" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#990F1115" Offset="0" />
          <GradientStop Color="#000F1115" Offset="0.7" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="48,0,48,40">
        <!-- Hero: logo (or title), what Lumen knows, Play and Details -->
        <Grid MinHeight="400" Visibility="{Binding HasFeatured, Converter={StaticResource BoolToVisibility}}">
          <StackPanel VerticalAlignment="Bottom" Margin="0,48,0,8">
            <Image Source="{Binding LogoPath, Converter={StaticResource ImagePath}, ConverterParameter=960}"
                   MaxHeight="150"
                   MaxWidth="480"
                   HorizontalAlignment="Left"
                   Stretch="Uniform"
                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.Name="{Binding FeaturedTitle}" />
            <TextBlock Text="{Binding FeaturedTitle}" FontSize="44" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasLogo}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding FeaturedFacts}" FontSize="15" Margin="0,16,0,0" Foreground="{DynamicResource Lumen.Brush.Text}" Opacity="0.85" />
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button Command="{Binding PlayCommand}"
                      Content="{Binding ActionText}"
                      IsEnabled="{Binding CanRun}"
                      Style="{StaticResource Lumen.Button}"
                      Background="{DynamicResource Lumen.Brush.Accent}"
                      BorderBrush="{DynamicResource Lumen.Brush.Accent}"
                      Foreground="White"
                      FontSize="16"
                      FontWeight="SemiBold"
                      Padding="40,11"
                      Margin="0,0,12,0" />
              <Button Command="{Binding OpenDetailCommand}"
                      Style="{StaticResource Lumen.Button}"
                      Background="#990F1115"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{l:Loc Home_Details}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE946;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                  <TextBlock Text="{l:Loc Home_Details}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="6" HorizontalAlignment="Left"
                Background="{DynamicResource Lumen.Brush.Surface}" BorderBrush="{DynamicResource Lumen.Brush.Divider}" BorderThickness="1"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" />
        </Border>

        <!-- Nothing to feature yet -->
        <StackPanel Margin="0,40,0,0" Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc Nav_Home}" Style="{StaticResource Lumen.Text.PageTitle}" />
          <TextBlock Text="{l:Loc Home_NoGames}" FontSize="15" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>

        <!-- Continue playing -->
        <StackPanel Margin="0,36,0,0" Visibility="{Binding HasFeatured, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc Home_ContinuePlaying}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="{l:Loc Home_NoHistory}" FontSize="14" Foreground="{DynamicResource Lumen.Brush.TextMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasContinuePlaying}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                        PreviewMouseWheel="OnRowMouseWheel">
            <ItemsControl ItemsSource="{Binding ContinuePlaying}" ItemTemplate="{StaticResource HomeTile}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Favorites -->
        <StackPanel Margin="0,28,0,0" Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc Collections_Favorites}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                        PreviewMouseWheel="OnRowMouseWheel">
            <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource HomeTile}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Quick apps: a compact dock of icons; a click opens the app -->
        <StackPanel Margin="0,24,0,0" Visibility="{Binding HasQuickApps, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc Home_QuickApps}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <ItemsControl ItemsSource="{Binding QuickApps}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:QuickAppViewModel}">
                <Button Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding Title}"
                        Cursor="Hand"
                        Margin="0,0,12,12"
                        Loaded="OnQuickAppLoaded"
                        AutomationProperties.Name="{Binding Title}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Frame" Width="88" Padding="8,12,8,8" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                              Background="{DynamicResource Lumen.Brush.Surface}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <StackPanel>
                    <Grid Width="44" Height="44">
                      <Image Source="{Binding IconPath, Converter={StaticResource ImagePath}, ConverterParameter=96}"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock x:Name="Initial" Text="{Binding Initial}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="12" Margin="0,8,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Lumen.Brush.Text}" />
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
