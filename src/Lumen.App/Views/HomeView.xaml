<UserControl x:Class="Lumen.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             xmlns:conv="clr-namespace:Lumen.App.Converters"
             xmlns:services="clr-namespace:Lumen.App.Services"
             DataContextChanged="OnDataContextChanged"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ImagePathConverter x:Key="ImagePath" />

    <!-- Section heading: a colored glyph and the title -->
    <Style x:Key="Home.SectionGlyph" TargetType="TextBlock" BasedOn="{StaticResource Lumen.Text.Icon}">
      <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.BodyLarge}" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Home.SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Lumen.FontSize.Subtitle}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Text}" />
    </Style>

    <!-- Round play button over a cover: shown while the cover is pointed at; mouse only (Enter on the cover opens the detail, which has Play) -->
    <Style x:Key="Home.TilePlay" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="46" Height="46">
              <Ellipse Fill="{DynamicResource Lumen.Brush.BrandGradient}" />
              <Ellipse x:Name="Sheen" Fill="#26FFFFFF" Visibility="Collapsed" />
              <TextBlock Text="&#xE768;" Style="{StaticResource Lumen.Text.Icon}" Foreground="White" HorizontalAlignment="Center" Margin="2,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding CanRun}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A game in a Home row (Continue playing, Favorites): cover (or icon) with its store, a play button on hover,
         title and playtime under it. Pointing at it features it, click opens it. -->
    <DataTemplate x:Key="HomeTile" DataType="{x:Type vm:HomeTileViewModel}">
      <StackPanel Width="150" Margin="0,0,18,12" ToolTip="{Binding Title}" Loaded="OnTileLoaded">
        <Button x:Name="Cover"
                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding Item}"
                Cursor="Hand"
                MouseEnter="OnTilePointed"
                GotKeyboardFocus="OnTilePointed"
                AutomationProperties.Name="{Binding Title}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid services:Motion.HoverScale="1.04">
                <!-- Hover/focus glow in the game's color: brush plus mask, collapsed until needed -->
                <Border x:Name="Glow" Margin="-14" CornerRadius="26" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="{DynamicResource Lumen.Brush.Accent}" Opacity="0.4">
                  <Border.OpacityMask>
                    <RadialGradientBrush>
                      <GradientStop Color="#FF000000" Offset="0.62" />
                      <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                  </Border.OpacityMask>
                </Border>
                <Border x:Name="Frame" Height="225" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FF1F2A40" Offset="0" />
                      <GradientStop Color="#FF121723" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <ContentPresenter />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                  <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lumen.Brush.Accent}" />
                  <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Grid>
            <Border CornerRadius="12">
              <Border.Background>
                <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Image Source="{Binding IconImage}"
                   Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="Initial" Text="{Binding Initial}" FontSize="60" FontWeight="Light" Opacity="0.6"
                       Foreground="{DynamicResource Lumen.Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Soft shade at the bottom so the cover sits on the page -->
            <Border CornerRadius="12" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#000A0D14" Offset="0.55" />
                  <GradientStop Color="#B30A0D14" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Style="{StaticResource Lumen.Badge}" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
              <TextBlock Text="{Binding StoreName}" Style="{StaticResource Lumen.Text.Badge}" />
            </Border>
            <Button Style="{StaticResource Home.TilePlay}"
                    Command="{Binding DataContext.PlayTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Title}" />
          </Grid>
        </Button>
        <TextBlock Text="{Binding Title}" Margin="2,10,2,0" FontSize="{StaticResource Lumen.FontSize.Small}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding PlaytimeText}" Margin="2,2,2,0" FontSize="{StaticResource Lumen.FontSize.Label}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                   Visibility="{Binding HasPlaytime, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasCover}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="Transparent" ClipToBounds="True">
    <!-- Background: the featured game's art, blurred, fading out down the page so the ambient lights show below.
         Two layers so a new game crossfades over the old one. Decoded small (it's blurred anyway). -->
    <Grid IsHitTestVisible="False" Opacity="0.55">
      <Grid.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF000000" Offset="0" />
          <GradientStop Color="#99000000" Offset="0.4" />
          <GradientStop Color="#00000000" Offset="0.8" />
        </LinearGradientBrush>
      </Grid.OpacityMask>
      <Image x:Name="BackgroundA" Stretch="UniformToFill" Opacity="0" Margin="-60" VerticalAlignment="Top">
        <Image.Effect>
          <BlurEffect Radius="40" KernelType="Gaussian" RenderingBias="Performance" />
        </Image.Effect>
      </Image>
      <Image x:Name="BackgroundB" Stretch="UniformToFill" Opacity="0" Margin="-60" VerticalAlignment="Top">
        <Image.Effect>
          <BlurEffect Radius="40" KernelType="Gaussian" RenderingBias="Performance" />
        </Image.Effect>
      </Image>
      <Border Background="#660A0D14" />
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="Sections" Margin="40,28,40,40">
        <!-- Hero card: the featured game's art, "Featured", last played, logo (or title), Play, Details and playtime -->
        <Border MinHeight="380" CornerRadius="24" BorderThickness="1" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}"
                Background="{DynamicResource Lumen.Brush.Surface}"
                Visibility="{Binding HasFeatured, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Border x:Name="HeroArt" CornerRadius="23">
              <Border.Background>
                <ImageBrush ImageSource="{Binding BackgroundPath, Converter={StaticResource ImagePath}, ConverterParameter=1280}"
                            Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <!-- Shades so the text reads over any artwork: from the bottom and from the left -->
            <Border CornerRadius="23" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#000A0D14" Offset="0" />
                  <GradientStop Color="#B30A0D14" Offset="0.65" />
                  <GradientStop Color="#FA0A0D14" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border CornerRadius="23" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#E60A0D14" Offset="0" />
                  <GradientStop Color="#990A0D14" Offset="0.45" />
                  <GradientStop Color="#000A0D14" Offset="0.85" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <StackPanel x:Name="HeroInfo" VerticalAlignment="Bottom" Margin="40,40,40,34" MaxWidth="720" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Lumen.Pill}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE734;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Label}"
                               Foreground="{DynamicResource Lumen.Brush.BrandText}" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Loc Home_Featured}" Style="{StaticResource Lumen.Text.Badge}" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding FeaturedLastPlayed}" FontSize="{StaticResource Lumen.FontSize.Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                           Visibility="{Binding HasFeaturedLastPlayed, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <Image Source="{Binding LogoPath, Converter={StaticResource ImagePath}, ConverterParameter=960}"
                     MaxHeight="130"
                     MaxWidth="440"
                     Margin="0,18,0,0"
                     HorizontalAlignment="Left"
                     Stretch="Uniform"
                     Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.Name="{Binding FeaturedTitle}" />
              <TextBlock Text="{Binding FeaturedTitle}" FontSize="{StaticResource Lumen.FontSize.Display}" FontWeight="Bold" TextWrapping="Wrap"
                         Margin="0,14,0,0" HorizontalAlignment="Left">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasLogo}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Command="{Binding PlayCommand}"
                        IsEnabled="{Binding CanRun}"
                        Style="{StaticResource Lumen.Button.Primary}"
                        FontSize="{StaticResource Lumen.FontSize.BodyLarge}"
                        Padding="30,12"
                        AutomationProperties.Name="{Binding ActionText}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Body}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ActionText}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenDetailCommand}"
                        Style="{StaticResource Lumen.Button}"
                        Background="#1AFFFFFF"
                        Padding="22,12"
                        Margin="12,0,0,0"
                        AutomationProperties.Name="{l:Loc Home_Details}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Margin="0,0,8,0" />
                    <TextBlock Text="{l:Loc Home_Details}" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasFeaturedPlaytime, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding FeaturedPlaytimeValue}" FontSize="{StaticResource Lumen.FontSize.BodyLarge}" FontWeight="Bold" />
                  <TextBlock Text="{Binding FeaturedPlaytimeLabel}" FontSize="{StaticResource Lumen.FontSize.Caption}" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" HorizontalAlignment="Left"
                Background="{DynamicResource Lumen.Brush.Glass}" BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}" BorderThickness="1"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="{StaticResource Lumen.FontSize.Body}" />
        </Border>

        <!-- Pinned routines: a click runs the routine (one that needs review opens its preview instead) -->
        <StackPanel Margin="0,32,0,0" Visibility="{Binding HasPinnedRoutines, Converter={StaticResource BoolToVisibility}}">
          <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Command="{Binding ShowRoutinesCommand}"
                    Style="{StaticResource Lumen.Button}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="{DynamicResource Lumen.Brush.BrandText}"
                    FontSize="{StaticResource Lumen.FontSize.Caption}"
                    Padding="8,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Loc Home_SeeAll}" FontWeight="SemiBold" />
                <TextBlock Text="&#xE76C;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Label}" Margin="6,0,0,0" />
              </StackPanel>
            </Button>
            <TextBlock Text="&#xE945;" Style="{StaticResource Home.SectionGlyph}" Foreground="{DynamicResource Lumen.Brush.Warning}" />
            <TextBlock Text="{l:Loc Home_PinnedRoutines}" Style="{StaticResource Home.SectionTitle}" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding PinnedRoutines}" Focusable="False" Margin="0,0,-14,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PinnedRoutineViewModel}">
                <Button Command="{Binding DataContext.RunRoutineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="0,0,14,14"
                        FocusVisualStyle="{x:Null}"
                        AutomationProperties.Name="{Binding Name}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid>
                        <Border x:Name="Frame" Padding="16,14" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Lumen.Brush.BrandBorder}">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#333B82F6" Offset="0" />
                              <GradientStop Color="#268B5CF6" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                          <ContentPresenter />
                        </Border>
                        <Border x:Name="Sheen" CornerRadius="16" Background="#12FFFFFF" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{DynamicResource Lumen.Brush.BrandText}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Lumen.Brush.BrandGradient}" Margin="12,0,0,0">
                      <TextBlock Text="&#xE768;" Style="{StaticResource Lumen.Text.Icon}" FontSize="{StaticResource Lumen.FontSize.Small}" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#1AFFFFFF" Margin="0,0,12,0">
                      <TextBlock Text="&#xE945;" Style="{StaticResource Lumen.Text.Icon}" Foreground="{DynamicResource Lumen.Brush.Text}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lumen.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Lumen.Brush.Text}" />
                      <TextBlock Text="{Binding Caption}" FontSize="{StaticResource Lumen.FontSize.Label}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Nothing to feature yet -->
        <StackPanel Margin="0,40,0,0" Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Loc Nav_Home}" Style="{StaticResource Lumen.Text.PageTitle}" />
          <TextBlock Text="{l:Loc Home_NoGames}" FontSize="{StaticResource Lumen.FontSize.Lead}" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>

        <!-- Continue playing -->
        <StackPanel Margin="0,22,0,0" Visibility="{Binding HasFeatured, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="&#xE823;" Style="{StaticResource Home.SectionGlyph}" Foreground="{DynamicResource Lumen.Brush.BrandText}" />
            <TextBlock Text="{l:Loc Home_ContinuePlaying}" Style="{StaticResource Home.SectionTitle}" />
          </StackPanel>
          <TextBlock Text="{l:Loc Home_NoHistory}" FontSize="{StaticResource Lumen.FontSize.Body}" Foreground="{DynamicResource Lumen.Brush.TextMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasContinuePlaying}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- The row clips what leaves it: the margins give a pointed-at tile (scaled up, with its glow) room to grow -->
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                        Margin="-16,-16,-16,-10" PreviewMouseWheel="OnRowMouseWheel">
            <ItemsControl ItemsSource="{Binding ContinuePlaying}" ItemTemplate="{StaticResource HomeTile}" Focusable="False" Margin="16,16,16,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Favorites -->
        <StackPanel Margin="0,22,0,0" Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="&#xE734;" Style="{StaticResource Home.SectionGlyph}" Foreground="{DynamicResource Lumen.Brush.Warning}" />
            <TextBlock Text="{l:Loc Collections_Favorites}" Style="{StaticResource Home.SectionTitle}" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                        Margin="-16,-16,-16,-10" PreviewMouseWheel="OnRowMouseWheel">
            <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource HomeTile}" Focusable="False" Margin="16,16,16,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Quick apps: chips with the app's icon; a click opens the app -->
        <StackPanel Margin="0,22,0,0" Visibility="{Binding HasQuickApps, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="&#xE71D;" Style="{StaticResource Home.SectionGlyph}" Foreground="#FFA78BFA" />
            <TextBlock Text="{l:Loc Home_QuickApps}" Style="{StaticResource Home.SectionTitle}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding QuickApps}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:QuickAppViewModel}">
                <Button Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource Lumen.Button}"
                        Background="{DynamicResource Lumen.Brush.Glass}"
                        BorderBrush="{DynamicResource Lumen.Brush.GlassBorder}"
                        Padding="14,10"
                        Margin="0,0,12,12"
                        ToolTip="{Binding Title}"
                        Loaded="OnQuickAppLoaded"
                        AutomationProperties.Name="{Binding Title}">
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="24" Height="24">
                      <Image Source="{Binding IconPath, Converter={StaticResource ImagePath}, ConverterParameter=48}"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock x:Name="Initial" Text="{Binding Initial}" FontSize="{StaticResource Lumen.FontSize.Body}" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lumen.FontSize.Small}" FontWeight="SemiBold" Margin="10,0,0,0" MaxWidth="170"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
