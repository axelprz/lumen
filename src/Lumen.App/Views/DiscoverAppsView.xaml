<!-- "Discover apps" (DiscoverAppsViewModel). Used over the library and as a step of the first-run wizard. -->
<UserControl x:Class="Lumen.App.Views.DiscoverAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <DockPanel>
    <!-- Title and close (close only when shown over the library) -->
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right"
              Command="{Binding CloseCommand}"
              Style="{StaticResource Lumen.Button}"
              VerticalAlignment="Top"
              AutomationProperties.Name="{l:Loc Detail_Back}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72B;" Style="{StaticResource Lumen.Text.Icon}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{l:Loc Detail_Back}" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="{l:Loc Discover_Title}" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="{l:Loc Discover_Body}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,20" MaxWidth="720" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
      </StackPanel>
    </DockPanel>

    <!-- Search and the suggestions / ignored switch -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Width="280" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,12,8"
               AutomationProperties.Name="{l:Loc Discover_Search}" />
      <Button Command="{Binding ToggleIgnoredCommand}"
              Content="{Binding ToggleIgnoredText}"
              Style="{StaticResource Lumen.Button}"
              Height="36"
              Margin="0,0,12,8"
              Visibility="{Binding HasIgnored, Converter={StaticResource BoolToVisibility}}" />
    </WrapPanel>

    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,10" CornerRadius="6" HorizontalAlignment="Left"
            Background="{DynamicResource Lumen.Brush.Surface}" BorderBrush="{DynamicResource Lumen.Brush.Divider}" BorderThickness="1"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" />
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" FontSize="15" Margin="0,8,0,0"
               Foreground="{DynamicResource Lumen.Brush.TextMuted}"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <!-- The list: virtualized, a PC can have a few hundred shortcuts -->
    <!-- Foreground set explicitly: a ListBox otherwise uses Windows' default (black) text color -->
    <ListBox ItemsSource="{Binding Visible}"
             Foreground="{DynamicResource Lumen.Brush.Text}"
             Background="Transparent"
             BorderThickness="0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             AutomationProperties.Name="{l:Loc Discover_Title}">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:AppSuggestion}">
          <Border Style="{StaticResource Lumen.Card}" Padding="16,10" Margin="0,0,8,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Suggestions: add / ignore. Ignored list: show again. -->
                <Button x:Name="Add"
                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        Content="{l:Loc Discover_Add}"
                        Style="{StaticResource Lumen.Button}"
                        Background="{DynamicResource Lumen.Brush.Accent}"
                        BorderBrush="{DynamicResource Lumen.Brush.Accent}"
                        Foreground="White"
                        Margin="12,0,0,0" />
                <Button x:Name="Ignore"
                        Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        Content="{l:Loc Discover_Ignore}"
                        Style="{StaticResource Lumen.Button}"
                        Margin="8,0,0,0" />
                <Button x:Name="Restore"
                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        Content="{l:Loc Discover_Restore}"
                        Style="{StaticResource Lumen.Button}"
                        Margin="12,0,0,0"
                        Visibility="Collapsed" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Lumen.Brush.TextMuted}">
                  <Run Text="{Binding Source, Mode=OneWay}" /><Run x:Name="Separator" Text=" · " /><Run Text="{Binding Location, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DataContext.ShowIgnored, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
              <Setter TargetName="Add" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Ignore" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Restore" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasLocation}" Value="False">
              <Setter TargetName="Separator" Property="Text" Value="" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
