<UserControl x:Class="Lumen.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization"
             xmlns:views="clr-namespace:Lumen.App.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="{l:Loc Nav_Settings}" Style="{StaticResource Lumen.Text.PageTitle}" Margin="0,0,0,24" />

      <!-- General -->
      <Border Style="{StaticResource Lumen.Card}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="{l:Loc Settings_General_Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
          <TextBlock Text="{l:Loc Settings_Language}" Style="{StaticResource Lumen.Text.Label}" />
          <ComboBox DataContext="{Binding Language}"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding Selected}"
                    DisplayMemberPath="Label"
                    MinWidth="240"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{l:Loc Settings_Language}" />
          <CheckBox Content="{l:Loc Settings_CloseToTray}"
                    IsChecked="{Binding Window.CloseToTray}"
                    Foreground="{DynamicResource Lumen.Brush.Text}"
                    FontSize="14"
                    Margin="0,20,0,0" />
          <CheckBox Content="{l:Loc Settings_StartWithWindows}"
                    IsChecked="{Binding Window.StartWithWindows}"
                    Foreground="{DynamicResource Lumen.Brush.Text}"
                    FontSize="14"
                    Margin="0,10,0,0" />
          <TextBlock Text="{l:Loc Settings_Hotkey}" Style="{StaticResource Lumen.Text.Label}" Margin="0,20,0,0" />
          <TextBlock Text="{l:Loc Settings_Hotkey_Description}"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal">
            <Border Background="{DynamicResource Lumen.Brush.Surface}"
                    BorderBrush="{DynamicResource Lumen.Brush.Divider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,6"
                    MinWidth="180"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding Window.HotkeyText}" FontSize="14" FontWeight="SemiBold" />
            </Border>
            <Button Content="{l:Loc Settings_Hotkey_Change}"
                    Command="{Binding Window.RecordHotkeyCommand}"
                    Style="{StaticResource Lumen.Button}"
                    Margin="8,0,0,0" />
            <Button Content="{l:Loc Settings_Hotkey_Reset}"
                    Command="{Binding Window.ResetHotkeyCommand}"
                    Style="{StaticResource Lumen.Button}"
                    Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding Window.HotkeyStatus}"
                     Foreground="{DynamicResource Lumen.Brush.Warning}"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Margin="0,8,0,0"
                     Visibility="{Binding Window.HasHotkeyStatus, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="{l:Loc Settings_ShowWelcome}"
                  Command="{Binding FirstRun.OpenCommand}"
                  Style="{StaticResource Lumen.Button}"
                  HorizontalAlignment="Left"
                  Margin="0,20,0,0" />
        </StackPanel>
      </Border>

      <views:SteamSettingsCard DataContext="{Binding Steam}" />
      <views:SteamFamilyCard DataContext="{Binding SteamFamily}" Margin="0,20,0,0" />
      <views:EpicAccountCard DataContext="{Binding Epic}" Margin="0,20,0,0" />
      <views:GogAccountCard DataContext="{Binding Gog}" Margin="0,20,0,0" />
      <views:ArtworkSettingsCard DataContext="{Binding Artwork}" Margin="0,20,0,0" />

      <!-- Library -->
      <Border Style="{StaticResource Lumen.Card}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="{l:Loc Settings_Library_Title}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{l:Loc Settings_Library_MergeDescription}"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                     TextWrapping="Wrap"
                     FontSize="14"
                     Margin="0,6,0,16" />
          <Button Content="{l:Loc Settings_Library_ResetMerges}"
                  Command="{Binding ResetMergesCommand}"
                  Style="{StaticResource Lumen.Button}"
                  HorizontalAlignment="Left" />
          <TextBlock Text="{Binding LibraryStatus}"
                     Foreground="{DynamicResource Lumen.Brush.Success}"
                     FontSize="14"
                     Margin="0,12,0,0"
                     Visibility="{Binding HasLibraryStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
