<!-- Sync folder (SyncSettingsViewModel): pick the folder, status, sync now, stop; the first-sync choice appears inline. -->
<UserControl x:Class="Lumen.App.Views.SyncSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc Settings_Sync_Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc Settings_Sync_Description}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="14"
                 Margin="0,6,0,16" />

      <!-- Where and how it is going -->
      <TextBlock Text="{Binding FolderText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasProblem}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- Both the folder and this PC already have data: ask before anything is written -->
      <Border Margin="0,16,0,0" Padding="16" CornerRadius="8"
              Background="{DynamicResource Lumen.Brush.Surface}"
              BorderBrush="{DynamicResource Lumen.Brush.Accent}" BorderThickness="1"
              Visibility="{Binding HasChoice, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{l:Loc Settings_Sync_Choice_Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{l:Loc Settings_Sync_Choice_Description}" FontSize="13" Margin="0,6,0,10" TextWrapping="Wrap"
                     Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
          <TextBlock Text="{l:Loc Settings_Sync_Choice_Folder}" Style="{StaticResource Lumen.Text.Label}" Margin="0" />
          <TextBlock Text="{Binding FolderSummary}" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="{l:Loc Settings_Sync_Choice_ThisPc}" Style="{StaticResource Lumen.Text.Label}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding ThisPcSummary}" FontSize="13" TextWrapping="Wrap" />
          <WrapPanel Margin="0,16,0,0">
            <Button Command="{Binding MergeCommand}"
                    Content="{l:Loc Settings_Sync_Merge}"
                    Style="{StaticResource Lumen.Button}"
                    Background="{DynamicResource Lumen.Brush.Accent}"
                    BorderBrush="{DynamicResource Lumen.Brush.Accent}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,12,8" />
            <Button Command="{Binding UseFolderCommand}" Content="{l:Loc Settings_Sync_UseFolder}" Style="{StaticResource Lumen.Button}" Margin="0,0,12,8" />
            <Button Command="{Binding UseThisPcCommand}" Content="{l:Loc Settings_Sync_UseThisPc}" Style="{StaticResource Lumen.Button}" Margin="0,0,12,8" />
            <Button Command="{Binding CancelChoiceCommand}" Content="{l:Loc Settings_Sync_Cancel}" Style="{StaticResource Lumen.Button}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Text="{l:Loc Settings_Sync_Merge_Hint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,16,0,0">
        <Button Command="{Binding ChooseFolderCommand}"
                Content="{l:Loc Settings_Sync_Choose}"
                Style="{StaticResource Lumen.Button}"
                Margin="0,0,12,8"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <Button Command="{Binding SyncNowCommand}"
                Content="{l:Loc Settings_Sync_Now}"
                Style="{StaticResource Lumen.Button}"
                Margin="0,0,12,8"
                Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <Button Command="{Binding StopCommand}"
                Content="{l:Loc Settings_Sync_Stop}"
                Style="{StaticResource Lumen.Button}"
                Margin="0,0,12,8"
                Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </WrapPanel>

      <TextBlock Text="{Binding Notice}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                 Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Message}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

      <!-- Files the last sync left alone, and why -->
      <Expander Header="{l:Loc Settings_Sync_Details}" Margin="0,8,0,0"
                Foreground="{DynamicResource Lumen.Brush.Text}"
                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding ProblemsText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" IsHitTestVisible="False"
                   Foreground="{DynamicResource Lumen.Brush.TextMuted}" />
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
