<!-- Updates (UpdateSettingsViewModel): version, channel, automatic check; Check now / Download / Restart. -->
<UserControl x:Class="Lumen.App.Views.UpdateSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lumen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{StaticResource Lumen.Card}">
    <StackPanel>
      <TextBlock Text="{l:Loc Settings_Updates_Title}" FontSize="{StaticResource Lumen.FontSize.Subtitle}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding VersionText}" FontSize="{StaticResource Lumen.FontSize.Body}" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Lumen.FontSize.Body}" Margin="0,4,0,0" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextMuted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Error}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CanRestart}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.Success}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="0,8,0,0"
                   Foreground="{DynamicResource Lumen.Brush.BrandText}"
                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

      <WrapPanel Margin="0,16,0,0">
        <Button Command="{Binding CheckNowCommand}"
                Content="{l:Loc Settings_Updates_CheckNow}"
                Style="{StaticResource Lumen.Button}"
                Margin="0,0,12,8"
                IsEnabled="{Binding CanCheck}" />
        <Button Command="{Binding DownloadCommand}"
                Content="{Binding DownloadText}"
                Style="{StaticResource Lumen.Button.Primary}"
                FontWeight="SemiBold"
                Margin="0,0,12,8"
                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
        <Button Command="{Binding RestartCommand}"
                Content="{l:Loc Settings_Updates_Restart}"
                Style="{StaticResource Lumen.Button.Primary}"
                FontWeight="SemiBold"
                Margin="0,0,12,8"
                Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
      </WrapPanel>

      <TextBlock Text="{l:Loc Settings_Updates_Channel}" Style="{StaticResource Lumen.Text.Label}" Margin="0,12,0,0" />
      <ComboBox ItemsSource="{Binding Options}"
                SelectedItem="{Binding SelectedChannel}"
                DisplayMemberPath="Label"
                MinWidth="240"
                HorizontalAlignment="Left"
                AutomationProperties.Name="{l:Loc Settings_Updates_Channel}" />
      <TextBlock Text="{l:Loc Settings_Updates_Channel_Hint}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource Lumen.FontSize.Caption}"
                 Margin="0,6,0,0" />
      <CheckBox Content="{l:Loc Settings_Updates_Automatic}"
                IsChecked="{Binding CheckAutomatically}"
                Foreground="{DynamicResource Lumen.Brush.Text}"
                FontSize="{StaticResource Lumen.FontSize.Body}"
                Margin="0,16,0,0" />
      <TextBlock Text="{l:Loc Settings_Updates_Privacy}"
                 Foreground="{DynamicResource Lumen.Brush.TextMuted}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource Lumen.FontSize.Caption}"
                 Margin="0,6,0,0" />
    </StackPanel>
  </Border>
</UserControl>
