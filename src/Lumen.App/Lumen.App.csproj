<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF app: views, view models, theming and the composition root. Windows only at runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lumen.App</RootNamespace>
    <AssemblyName>Lumen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Lumen.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <!-- Program.Main is the entry point (Velopack must run first), so App.xaml is a page, not the application definition. -->
    <StartupObject>Lumen.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Lumen.ico" />
    <!-- Exo 2 (SIL OFL), static weights cut from the official variable font; WPF does not handle variable axes. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped next to Lumen.exe: the GPL text and the licenses of everything bundled (Settings -> About opens it). -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
    <ProjectReference Include="..\Lumen.Data\Lumen.Data.csproj" />
    <ProjectReference Include="..\Lumen.Providers\Lumen.Providers.csproj" />
    <ProjectReference Include="..\Lumen.Platform.Windows\Lumen.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
