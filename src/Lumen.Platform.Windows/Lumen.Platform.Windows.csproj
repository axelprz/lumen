<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only implementations: known folders, registry, processes, shell, DPAPI, window interop. Keep it thin. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Lumen.Platform.Windows</RootNamespace>
    <!-- Required by [LibraryImport] generated marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
