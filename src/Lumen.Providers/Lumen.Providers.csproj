<Project Sdk="Microsoft.NET.Sdk">
  <!-- Store/app providers' parsing logic. Pure and testable; OS access comes through Lumen.Core abstractions. -->
  <PropertyGroup>
    <RootNamespace>Lumen.Providers</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Junk filters, exclusion lists, title cleanup: data, not code. -->
    <EmbeddedResource Include="Data\*.json" LogicalName="Lumen.Providers.Data.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lumen.Providers.Tests" />
  </ItemGroup>
</Project>
