{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axelprz/lumen/docs/schemas/collection.schema.json",
  "title": "Lumen collection",
  "description": "A user collection of games and/or apps, referenced by stable ItemRef strings. Favorites is the reserved collection with id 'favorites'.",
  "type": "object",
  "required": ["schema", "id", "name", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 80 },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      ]
    },
    "icon": { "type": "string", "maxLength": 40 },
    "sort": { "enum": ["manual", "name", "lastPlayed", "playtime"], "default": "manual" },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+:.+$" }
    }
  }
}
